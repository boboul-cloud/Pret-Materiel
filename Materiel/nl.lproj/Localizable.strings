/* Gids - AI-Scanner */
"guide_scanner_intro_title" = "Slimme Scanner";
"guide_scanner_intro_content" = "De AI-scanner gebruikt OpenAI Vision-technologie (GPT-4o) om je uitrusting automatisch te identificeren vanaf een foto. Het herkent het objecttype, merk, model en stelt een passende categorie voor.";
"guide_scanner_apikey_title" = "OpenAI API-Sleutel Vereist";
"guide_scanner_apikey_content" = "Om deze functie te gebruiken, heb je een OpenAI API-sleutel nodig:\n\n1. Maak een account aan op platform.openai.com\n2. Ga naar API Keys en maak een nieuwe sleutel aan\n3. Kopieer de sleutel (begint met 'sk-')\n4. Plak deze in de app bij het eerste gebruik van de scanner\n\nJe sleutel wordt alleen op je apparaat opgeslagen en wordt nooit gedeeld.";
"guide_scanner_cost_title" = "Gebruikskosten";
"guide_scanner_cost_content" = "Het gebruik van de OpenAI API is betaald:\n\n• Ongeveer €0,003 tot €0,01 per geanalyseerde foto\n• Kosten worden direct gefactureerd op je OpenAI-account\n• Je kunt bestedingslimieten instellen op platform.openai.com\n• Controleer je gebruik regelmatig in je OpenAI-dashboard\n\nDe app heeft geen toegang tot je betalingsgegevens.";
"guide_scanner_howto_title" = "Hoe Het Werkt";
"guide_scanner_howto_content" = "1. Tik op 'Scannen met AI' in de uitrustingslijst\n2. Maak een foto of kies een bestaande afbeelding\n3. Tik op 'Identificeren met AI'\n4. De afbeelding wordt naar OpenAI gestuurd voor analyse\n5. Velden worden automatisch ingevuld\n6. Controleer en wijzig indien nodig\n7. Maak de uitrusting aan";
"guide_scanner_tips_title" = "Tips voor Betere Resultaten";
"guide_scanner_tips_content" = "• Maak de foto in een goed verlicht gebied\n• Kader het hele object in de afbeelding\n• Neem indien mogelijk het label of merklogo mee\n• Vermijd wazige of te donkere foto's\n• Een neutrale achtergrond verbetert de herkenning";
"guide_scanner_internet_title" = "Internetverbinding Vereist";
"guide_scanner_internet_content" = "De AI-scanner vereist een internetverbinding om te werken. De afbeelding wordt naar OpenAI-servers gestuurd voor analyse. Zonder verbinding kun je je uitrusting nog steeds handmatig toevoegen.";
"guide_scanner_privacy_title" = "Privacy";
"guide_scanner_privacy_content" = "• Je API-sleutel wordt lokaal op je apparaat opgeslagen\n• Afbeeldingen worden rechtstreeks naar OpenAI gestuurd (geen tussenserver)\n• Zie het privacybeleid van OpenAI voor meer informatie\n• Je kunt je sleutel op elk moment verwijderen in de scannerinstellingen";

/* Gids - Introductie */
"guide_intro_title" = "Welkom bij Materiaal";
"guide_intro_content" = "Materiaal is je complete assistent voor het beheren van alles wat je uitleent, leent, verhuurt of verkoopt.\n\n📦 Inventaris: Catalogiseer je uitrusting met foto's en bonnen\n🔄 Uitleningen: Volg wie wat heeft en tot wanneer\n💰 Verhuur: Verhuur je uitrusting en beheer betalingen\n🛒 Handel: Beheer je aankopen en verkopen met BTW\n🔐 Kluis: Bescherm je belangrijke documenten\n📊 Boekhouding: Volg je inkomsten en uitgaven\n\nNavigeer tussen de tabbladen onderaan om de verschillende functies te openen.";

/* Gids - Startpagina */
"guide_home_title" = "Startpagina";
"guide_home_content" = "De startpagina geeft snelle toegang tot de belangrijkste acties:\n\n📸 Snelle uitlening: Fotografeer een item dat je uitleent, voeg info toe en klaar!\n\n📸 Snelle lening ontvangen: Iemand leent je iets? Noteer het in seconden.\n\n👑 Word Premium: De gratis versie heeft beperkte items. Premium ontgrendelt alles onbeperkt.\n\nDe snelknoppen maken automatisch uitrusting en contacten aan indien nodig.";

/* Gids - Snel aanmaken */
"guide_quick_create_title" = "Snel aanmaken met foto";
"guide_quick_create_content" = "Snel aanmaken is de makkelijkste manier om te beginnen:\n\n1️⃣ Tik op 'Snelle uitlening aanmaken' of 'Snelle lening ontvangen aanmaken'\n2️⃣ Maak een foto van het item (optioneel maar aanbevolen)\n3️⃣ Voer de naam van het item in\n4️⃣ Voeg de naam van de persoon toe\n5️⃣ Stel de verwachte retourdatum in\n6️⃣ Bevestig!\n\nDe app maakt automatisch aan:\n• De uitrustingsfiche met foto\n• Het contact als het nieuw is\n• De uitlening met datums\n\nJe kunt deze elementen op elk moment bewerken.";

/* Gids - Navigatie */
"guide_navigation_title" = "Navigeren in de app";
"guide_navigation_content" = "De app is georganiseerd in 5 hoofdtabbladen:\n\n🏠 Start: Snelle acties en overzicht\n\n📦 Materiaal: Je complete inventaris met filters op categorie, locatie en status\n\n↗️ Uitleningen: Wat je aan anderen uitleent (filterbaar op status: Lopend, Verlopen, Terug)\n\n↙️ Geleend: Wat anderen aan jou uitlenen (zelfde filters beschikbaar)\n\n⚙️ Overig: Personen, Locaties, Bouwplaatsen, Verhuur, Reparaties, Handel, Boekhouding, Kluis en Instellingen\n\nElke lijst is doorzoekbaar en sorteerbaar.";

/* Gids - Taal */
"guide_language_title" = "Taal wijzigen";
"guide_language_content" = "De app is beschikbaar in 7 talen:\n🇫🇷 Français\n🇬🇧 English\n🇩🇪 Deutsch\n🇪🇸 Español\n🇮🇹 Italiano\n🇵🇹 Português\n🇳🇱 Nederlands\n\nOm de taal te wijzigen:\n1. Ga naar Overig > Instellingen\n2. Selecteer de vlag van je taal\n\nDe taal wordt direct toegepast in de hele app.";

/* Gids - Materiaal */
"guide_equipment_title" = "Je materiaal beheren";
"guide_equipment_content" = "Het tabblad Materiaal is je centrale inventaris:\n\n➕ Uitrusting toevoegen:\n• Naam en gedetailleerde beschrijving\n• Categorie (maak je eigen)\n• Geschatte waarde in €\n• Aanschafdatum\n• Opslaglocatie (optioneel)\n• Precieze positie (bijv. bovenste plank)\n• Foto van het item\n• Foto van de bon met nummer en verkoper\n\n🔍 Inventaris filteren:\n• Op categorie (Gereedschap, Sport, Keuken...)\n• Op opslaglocatie\n• Op status (Beschikbaar, Uitgeleend, Verhuurd)\n• Op tekstzoekopdracht\n\n📊 Details bekijken:\n• Uitleengeschiedenis\n• Verhuurgeschiedenis\n• Reparatiegeschiedenis";

/* Gids - Foto's */
"guide_photos_title" = "Foto's en bonnen";
"guide_photos_content" = "Foto's verrijken je fiches:\n\n📷 Uitrustingsfoto:\n• Identificeer het item visueel\n• Zichtbaar in lijsten en PDF-exports\n• Maak direct of kies uit galerij\n\n🧾 Bonfoto:\n• Belangrijk aankoopbewijs\n• Bonnummer en verkoper (optioneel)\n• Handig voor verzekering of garantie\n• Exporteerbaar naar PDF\n\n💡 Kwaliteitstip:\nKies in Instellingen > Beeldkwaliteit:\n• Origineel: Max kwaliteit, grote bestanden\n• Hoog: Goed compromis\n• Medium: Aanbevolen (licht en voldoende)\n• Laag: Om ruimte te besparen";

/* Gids - Uitleningen */
"guide_loans_title" = "Uitleningen aanmaken en beheren";
"guide_loans_content" = "Een uitlening = uitrusting die je aan iemand toevertrouwt.\n\n➕ Een uitlening aanmaken:\n1. Selecteer de uit te lenen uitrusting\n2. Kies de lener (of maak een nieuwe)\n3. Stel datums in (begin en verwacht einde)\n4. Voeg notities toe indien nodig\n\n📋 Uitleenstatus:\n🟢 Lopend: Actieve uitlening, niet verlopen\n🟡 Binnenkort: Vervalt over minder dan 3 dagen\n🔴 Verlopen: Einddatum verstreken\n✅ Terug: Uitrusting teruggebracht\n\n✔️ Een retour bevestigen:\nTik op 'Retour bevestigen' in de uitleenfiche. De werkelijke retourdatum wordt geregistreerd.\n\n📧 Opvolgen met een lener:\nVanuit de persoonsfiche, stuur een e-mail met samenvatting van lopende items.";

/* Gids - Leningen ontvangen */
"guide_borrows_title" = "Je leningen ontvangen bijhouden";
"guide_borrows_content" = "Een lening ontvangen = iets dat iemand aan jou uitleent.\n\n➕ Een lening ontvangen aanmaken:\n1. Benoem het geleende item\n2. Selecteer de uitlener (persoon die aan jou uitleent)\n3. Stel begin- en verwachte retourdatum in\n4. Maak een foto van het item\n5. Voeg notities toe (staat, voorwaarden...)\n\n🔄 Acties op een lening ontvangen:\n• Uitlenen aan een andere persoon\n• Onderverhuren (subverhuur)\n• Opsturen voor reparatie\n• Terugbrengen naar de uitlener\n\n📦 Aanmaken in Materiaal:\nActiveer deze optie om het geleende item aan je inventaris toe te voegen. Het wordt automatisch verwijderd bij retour.\n\n⚠️ Blokkering:\nJe kunt een lening ontvangen niet retourneren als het momenteel is uitgeleend, verhuurd of in reparatie.";

/* Gids - Geleend uitlenen */
"guide_lend_borrow_title" = "Een geleend item uitlenen";
"guide_lend_borrow_content" = "Wil je tijdelijk iets uitlenen dat je zelf hebt geleend?\n\n📤 Hoe te doen:\n1. Ga naar de fiche van de lening ontvangen\n2. Tik op 'Uitlenen'\n3. Selecteer de persoon aan wie je uitleent\n4. Stel de verwachte retourdatum in\n\n⚠️ Blokkeringsregels:\n• De lening ontvangen kan niet worden geretourneerd zolang de uitlening actief is\n• Je moet eerst het item van de uitlening terughalen\n• Dan kun je de lening ontvangen retourneren\n\n🔄 Zelfde logica voor:\n• Een lening ontvangen verhuren (onderverhuur)\n• Een lening ontvangen voor reparatie sturen\n\nDit maakt complete tracking van de bezitsketen mogelijk.";

/* Gids - Reparaties */
"guide_repairs_title" = "Reparaties beheren";
"guide_repairs_content" = "Stuur je uitrusting voor reparatie en volg de kosten.\n\n🔧 Een reparatie aanmaken:\n1. Selecteer de te repareren uitrusting\n2. Kies een reparateur ('Reparateur' type vereist)\n3. Beschrijf het probleem\n4. Voer de geschatte kosten in\n5. Stel de verwachte retourdatum in\n\n📊 Tracking:\n• Status: Lopend / Voltooid\n• Geschatte vs werkelijke kosten\n• Vertragingsindicator indien verlopen\n\n✅ Een reparatie voltooien:\n1. Bevestig retour\n2. Voer werkelijke kosten in\n3. Markeer als 'Betaald' wanneer verrekend\n\n💰 Boekhouding:\nReparaties worden automatisch geregistreerd als uitgaven.";

/* Gids - Retouren */
"guide_return_title" = "Retouren bevestigen";
"guide_return_content" = "Wanneer een item wordt teruggebracht, bevestig de retour:\n\n✅ Voor een uitlening:\nTik op 'Retour bevestigen'. De uitrusting wordt weer beschikbaar.\n\n✅ Voor een lening ontvangen:\nTik op 'Retour bevestigen'. De lening ontvangen wordt als geretourneerd gemarkeerd.\n\n✅ Voor een verhuur:\nTik op 'Verhuur beëindigen'. Je moet dan:\n• Betaling markeren als ontvangen\n• Borg beheren (teruggeven of inhouden)\n\n✅ Voor een reparatie:\nTik op 'Reparatieretour bevestigen'. Voer de werkelijke kosten in.\n\n💡 Tip:\nRetouren hebben een datum/tijd stempel. Je vindt de volledige geschiedenis in elke fiche.";

/* Gids - Verhuur */
"guide_rentals_title" = "Je uitrusting verhuren";
"guide_rentals_content" = "Verhuur stelt je in staat je uitrusting tegen betaling te verhuren.\n\n➕ Een verhuur aanmaken:\n1. Selecteer de te verhuren uitrusting\n2. Kies de huurder\n3. Stel het tarieftype in:\n   • Dag (prijs × aantal dagen)\n   • Week (prijs × aantal weken)\n   • Maand (prijs × aantal maanden)\n   • Vast bedrag\n4. Voer het borgbedrag in\n5. Stel de datums in\n\n📊 Dashboard:\n• Ontvangen inkomsten (bevestigde betalingen)\n• In afwachting (nog niet betaald)\n\n✅ Een verhuur beëindigen:\n1. Beëindig de verhuur wanneer het item is teruggebracht\n2. Bevestig ontvangst van betaling\n3. Beheer de borg (teruggeven of inhouden)";

/* Gids - Borg */
"guide_caution_title" = "Borgen beheren";
"guide_caution_content" = "De borg is een waarborg die aan het einde van de verhuur wordt geïnd.\n\n💵 Actietypes:\n\n🔙 Borg teruggeven:\nAls alles OK is, geef de borg terug aan de huurder. Telt niet als inkomsten.\n\n⚠️ Borg inhouden:\nBij schade of geschil, houd geheel of gedeeltelijk in. Het ingehouden bedrag wordt toegevoegd aan je inkomsten.\n\n📋 Tracking in 'Overig':\nDe sectie 'Terug te geven borgen' toont alle beëindigde verhuren met openstaand borgbeheer.\n\n💰 Boekhouding:\nAlleen ingehouden borgen verschijnen in de boekhouding als uitzonderlijke inkomsten.";

/* Gids - Onderverhuur */
"guide_sublet_title" = "Uitrusting onderverhuren";
"guide_sublet_content" = "Je kunt uitrusting onderverhuren die je zelf huurt.\n\n📤 Hoe te doen:\n1. Ga naar je actieve verhuurfiche\n2. Tik op 'Onderverhuren'\n3. Selecteer de onderhuurder\n4. Stel je eigen tarieven en voorwaarden in\n\n⚠️ Regels:\n• De hoofdverhuur kan niet worden beëindigd zolang de onderverhuur actief is\n• Haal eerst de uitrusting terug van de onderverhuur\n• Beëindig dan de hoofdverhuur\n\n💰 Inkomsten:\nOnderverhuurinkomsten worden toegevoegd aan je normale boekhouding.";

/* Gids - Ik huur */
"guide_myrentals_title" = "Ik huur - Uitrusting die ik huur";
"guide_myrentals_content" = "De sectie 'Ik huur' laat je uitrusting beheren die JIJ van iemand anders huurt (externe uitrustingshuur).\n\n📤 Een huur aanmaken:\n1. Tik op 'Huur toevoegen'\n2. Geef de gehuurde uitrusting een naam\n3. Selecteer de verhuurder (van wie je huurt)\n4. Stel het tarieftype in (dag/week/maand/forfait)\n5. Voer de prijs en betaalde borg in\n6. Stel begin- en einddatum in\n\n📊 Tracking:\n• Totaal huurbedrag\n• Betaalde en terugontvangen borg\n• Status: Lopend, Te laat, Beëindigd\n• Betaling gedaan of in afwachting\n\n✅ Een huur beëindigen:\n1. Markeer de huur als beëindigd\n2. Voer het terugontvangen borgbedrag in\n3. Bevestig de gedane betaling\n\n⚠️ Herinneringen:\nHuren met niet-terugontvangen borg verschijnen als waarschuwingen.";

/* Gids - Mijn borgen */
"guide_myrentals_caution_title" = "Mijn betaalde borgen beheren";
"guide_myrentals_caution_content" = "Wanneer je uitrusting huurt, betaal je vaak een borg.\n\n💵 Borgtracking:\n• Betaald borgbedrag bij ondertekening\n• Terugontvangen bedrag aan het einde van de huur\n• Verschil bij inhouding\n\n🔄 Workflow:\n1. Bij aanmaken, voer de betaalde borg in\n2. Aan het einde van de huur, voer terugontvangen bedrag in\n3. Het verschil wordt automatisch berekend\n\n📋 Waarschuwingen:\nIn 'Overig > Ik huur' waarschuwt een melding je als beëindigde huren niet-terugontvangen borgen hebben.\n\n💰 Boekhouding:\n• Betaalde borg = tijdelijke uitgave\n• Terugontvangen borg = terugbetaling\n• Niet-terugontvangen borg = verlies (definitieve uitgave)";

/* Gids - Handel */
"guide_commerce_title" = "Koop/Verkoop Module";
"guide_commerce_content" = "De Handelsmodule is ideaal voor markten, winkels en kleine bedrijven.\n\n📦 Functies:\n• Productcatalogus met inkoop- en verkoopprijzen\n• Automatisch voorraadbeheer\n• BTW-berekening (geïnd, aftrekbaar, te betalen)\n• Percentage of vast bedrag kortingen\n• Betaalmethoden (contant, kaart, cheque, overschrijving)\n• Uitgestelde betalingen met herinneringen\n\n📊 Commerciële boekhouding:\n• Totaal verkopen / aankopen / winst\n• BTW-detail per tarief\n• Gemiddeld bonbedrag\n• Uitsplitsing per betaalmethode\n• Lage voorraadwaarschuwingen\n\n🔄 Exporteer/importeer JSON voor gegevensback-up.";

/* Gids - Artikelen */
"guide_articles_title" = "Je producten beheren";
"guide_articles_content" = "Producten zijn items in je commerciële catalogus.\n\n➕ Een product aanmaken:\n• Naam en beschrijving\n• Categorie (maak je eigen)\n• Referentie / SKU\n• Inkoopprijs excl. BTW en inkoop-BTW-tarief\n• Verkoopprijs incl. BTW en verkoop-BTW-tarief\n• Huidige voorraad en waarschuwingslimiet\n• Leverancier (optioneel)\n• Foto (optioneel)\n\n📊 Automatische marge:\nDe app berekent automatisch je marge en percentage.\n\n🔔 Voorraadwaarschuwingen:\nWanneer voorraad onder de limiet zakt, verschijnt het item in waarschuwingen.\n\n⚡ Snelle verkoop:\nHoud lang ingedrukt op een product voor snelle verkoop zonder complexe invoer.";

/* Gids - Transacties */
"guide_transactions_title" = "Transacties registreren";
"guide_transactions_content" = "Transacties zijn je verkopen en aankopen.\n\n🛒 Een transactie aanmaken:\n1. Kies type: Verkoop of Aankoop\n2. Selecteer een item uit de catalogus OF voer vrij in\n3. Voer hoeveelheid in\n4. Pas korting toe (optioneel): % of vast bedrag\n5. Kies betaalmethode: Contant, Kaart, Cheque, Overschrijving\n6. Geef aan of betaald of in afwachting\n7. Indien in afwachting, stel betaaldatum in\n\n📊 Automatisch overzicht:\n• Bruto bedrag excl. BTW\n• Toegepaste korting\n• Netto bedrag excl. BTW\n• Berekende BTW\n• Totaal incl. BTW\n\n🔔 Herinneringen:\nActiveer notificaties voor naderende betalingen (3 dagen van tevoren).";

/* Gids - Boekhouding */
"guide_accounting_title" = "Verhuurboekhouding";
"guide_accounting_content" = "De boekhouding groepeert automatisch je financiële operaties.\n\n📊 Inhoud:\n• Inkomsten: Betaalde verhuur\n• Inkomsten: Ingehouden borgen\n• Uitgaven: Betaalde reparaties\n\n📅 Perioden:\n• Maandoverzicht\n• Jaaroverzicht\n• Totaaloverzicht\n\n💰 Indicatoren:\n• Totale inkomsten (groen)\n• Totale uitgaven (rood)\n• Nettowinst\n\n📤 Exporteren:\n• Geformatteerde PDF voor boekhouding\n• JSON voor back-up/import\n\nOperaties worden automatisch toegevoegd wanneer je een betaling als ontvangen markeert.";

/* Gids - Commerciële boekhouding */
"guide_commerce_accounting_title" = "Commerciële boekhouding";
"guide_commerce_accounting_content" = "Volledig overzicht van je verkoopactiviteit.\n\n📊 Dashboard:\n• Totaal verkopen incl. BTW\n• Totaal aankopen incl. BTW\n• Nettowinst\n• Gemiddeld bonbedrag (verkoop en aankoop)\n\n💹 Gedetailleerde BTW:\n• Geïnde BTW (op verkopen)\n• Aftrekbare BTW (op aankopen)\n• Te betalen BTW (verschil)\n• Detail per tarief (9%, 21%...)\n\n💳 Betalingsuitsplitsing:\n• Contant / Kaart / Cheque / Overschrijving\n• Percentageweergave\n\n📦 Voorraad:\n• Aantal items op voorraad\n• Items in waarschuwing (lage voorraad)\n\n💸 Verleende kortingen:\n• Totaal kortingen op verkopen\n• Totaal kortingen op aankopen";

/* Gids - Personen */
"guide_people_title" = "Contactenlijst";
"guide_people_content" = "Beheer de mensen met wie je interacteert.\n\n➕ Een persoon toevoegen:\n• Voor- en achternaam\n• E-mail (maakt e-mails versturen mogelijk)\n• Telefoon (maakt direct bellen mogelijk)\n• Organisatie (bedrijf, vereniging...)\n• Type: Persoon, Reparateur of Werknemer\n• Foto (optioneel)\n\n📧 Herinneringse-mail:\nVanuit de fiche van een persoon, stuur een e-mail met automatisch:\n• Momenteel geleende uitrusting\n• Verwachte retourdata\n• Vertragingsindicaties\n\n📞 Direct bellen:\nTik op het telefoonnummer om direct te bellen.\n\n📇 Contacten importeren:\nImporteer automatisch vanuit je iPhone-contacten.";

/* Gids - Persoonstypes */
"guide_people_types_title" = "Persoonstypes";
"guide_people_types_content" = "Drie types om je contacten te organiseren:\n\n👤 Persoon (standaard):\nKlanten, vrienden, familie... Iedereen aan wie je uitrusting uitleent of verhuurt.\n\n🔧 Reparateur:\nAmbachtslieden en reparatiewerkplaatsen. Alleen reparateurs kunnen worden geselecteerd bij het versturen voor reparatie.\n\n👷 Werknemer:\nTeamleden. Kunnen worden toegewezen aan bouwplaatsen. Ideaal voor bedrijven met meerdere locaties.\n\n💡 Tip:\nEen persoon kan slechts één type hebben. Wijzig op elk moment vanuit hun fiche.";

/* Gids - Duplicaten */
"guide_duplicates_title" = "Duplicaten samenvoegen";
"guide_duplicates_content" = "De app detecteert automatisch dubbele personen.\n\n🔍 Hoe het werkt:\n• Detectie op identieke voor- + achternaam\n• Negeert hoofd/kleine letters en spaties\n\n🔄 Samenvoegen:\n1. Ga naar Overig > Personen\n2. Tik op de 'Duplicaten' knop in de werkbalk\n3. Selecteer de duplicatengroep\n4. Kies de te behouden persoon\n5. Bevestig samenvoeging\n\n✅ Resultaat:\n• Alle uitleningen worden hertoegewezen\n• Alle leningen ontvangen worden hertoegewezen\n• Alle verhuren worden hertoegewezen\n• Duplicaten worden verwijderd\n\n💡 Controleer de contactgegevens van de behouden persoon.";

/* Gids - Bouwplaatsen */
"guide_worksites_title" = "Bouwplaatsbeheer";
"guide_worksites_content" = "Organiseer je team over meerdere werklocaties.\n\n🏗️ Een bouwplaats aanmaken:\n• Naam van de bouwplaats\n• Volledig adres\n• Beschrijving en notities\n• Start- en einddatums\n• Hoofdcontact ter plaatse\n• Status: Actief of Voltooid\n\n👷 Werknemers toewijzen:\n1. Maak personen van het type 'Werknemer' aan\n2. Open de bouwplaatsfiche\n3. Voeg relevante werknemers toe\n\n🗺️ Navigatie:\nTik op het adres om te openen in Kaarten.\n\n📊 Automatische statussen:\n• Voorbereidend: Startdatum niet bereikt\n• Actief: In uitvoering\n• Voltooid: Gemarkeerd als afgerond\n\n📤 Exporteer naar PDF of JSON.";

/* Gids - Locaties */
"guide_locations_title" = "Opslaglocaties";
"guide_locations_content" = "Organiseer waar je uitrusting is opgeslagen.\n\n📍 Een locatie aanmaken:\n• Naam (bijv. Garage, Noord Magazijn...)\n• Volledig adres\n• Gebouw\n• Verdieping\n• Kamer\n• Notities\n\n📦 Gebruik:\n• Koppel elke uitrusting aan een locatie\n• Voeg precieze positionering toe (bijv. plank B, lade 3)\n• Filter je inventaris op locatie\n\n🔍 Een item vinden:\n1. Zoek in Materiaal\n2. De fiche toont locatie en exacte positie\n\n📊 Overzicht:\nDe fiche van een locatie toont alle daar opgeslagen uitrusting.";

/* Gids - Categorieën */
"guide_categories_title" = "Categorieën beheren";
"guide_categories_content" = "Categorieën organiseren je inventaris.\n\n➕ Een categorie aanmaken:\nBij het toevoegen van uitrusting, typ een nieuwe categorienaam.\n\n🗂️ Voorgestelde categorieën:\n• Gereedschap\n• Elektronica\n• Sport\n• Keuken\n• Tuin\n• Doe-het-zelf\n• Muziek\n• Foto/Video\n\n📝 Categorieën beheren:\n1. In de Materiaallijst\n2. Tik op het mapicoon naast het categoriefilter\n3. Hernoem of verwijder\n\n⚠️ Een categorie verwijderen:\nUitrusting wordt niet verwijderd, verliest alleen de categorie.";

/* Gids - Zoeken */
"guide_search_title" = "Zoeken en filteren";
"guide_search_content" = "Vind snel elk item.\n\n🔍 Zoekbalk:\n• Beschikbaar in elke lijst\n• Zoekt op naam en beschrijving\n• Realtime resultaten\n\n🎯 Combineerbare filters:\n\n📦 Materiaal:\n• Op categorie\n• Op opslaglocatie\n• Op status (Beschikbaar, Uitgeleend, Verhuurd)\n\n↗️ Uitleningen / ↙️ Geleend:\n• Alle / Lopend / Verlopen / Terug / Binnenkort\n\n🏷️ Verhuur:\n• Op status\n• Op betaalstatus\n• Op borgstatus\n\n🔧 Reparaties:\n• Lopend / Voltooid\n• Betaald / Niet betaald\n\n💡 Resetknop:\nReset alle filters met één tik.";

/* Gids - Status */
"guide_status_title" = "Statussen begrijpen";
"guide_status_content" = "Kleurcodes door de hele app:\n\n🟢 Groen:\n• Beschikbaar\n• Teruggebracht\n• Betaald\n• Voltooid\n\n🟡 Oranje:\n• Lopend\n• Binnenkort (< 3 dagen)\n• In afwachting van betaling\n\n🔴 Rood:\n• Verlopen\n• Niet betaald (datum verstreken)\n• Probleem gedetecteerd\n\n🔵 Blauw:\n• Informatie\n• Klikbare link\n• Beschikbare actie\n\n📊 Visuele indicatoren:\n• Klokicoon: Lopend\n• Driehoekicoon: Verlopen\n• Vinkicoon: Voltooid/Terug\n• Numerieke badge: Itemtelling";

/* Gids - Kluis */
"guide_safe_title" = "Beveiligde kluis";
"guide_safe_content" = "Bescherm je belangrijke documenten met beveiligde toegang.\n\n🔐 Instellen:\n1. Maak een wachtwoord aan (min. 4 tekens)\n2. Kies een herselvraag\n3. Beantwoord de geheime vraag\n\n📦 Aanbevolen inhoud:\n• Waardevolle sieraden en horloges\n• Dure elektronica\n• Kunstwerken\n• Belangrijke documenten\n• Bonnen van grote aankopen\n\n🏷️ Voor elk item:\n• Foto van het item\n• Naam en beschrijving\n• Geschatte waarde\n• Merk, model, serienummer\n• Foto van bon/aankoopbewijs\n\n📄 Inventaris voor verzekering:\nExporteer een volledige PDF voor je verzekeraar.";

/* Gids - Biometrie */
"guide_biometric_title" = "Face ID / Touch ID";
"guide_biometric_content" = "Open de kluis met biometrie.\n\n✅ Voordelen:\n• Snelle toegang zonder wachtwoord typen\n• Verbeterde beveiliging\n• Zelfde beschermingsniveau als je iPhone\n\n🔧 Activering:\nBiometrische authenticatie is automatisch als je apparaat dit ondersteunt.\n\n📱 Compatibiliteit:\n• Face ID (iPhone X en later)\n• Touch ID (iPhone met sensor)\n\n🔑 Fallback:\nAls biometrie faalt, typ je wachtwoord.\n\n⚠️ Wachtwoord vergeten:\n1. Gebruik de herselvraag\n2. Laatste redmiddel: volledige reset (gegevensverlies)";

/* Gids - Wachtwoord */
"guide_password_title" = "Wachtwoordbeheer";
"guide_password_content" = "Bescherm je kluis met een sterk wachtwoord.\n\n🔑 Regels:\n• Minimaal 4 tekens\n• Bevestiging vereist\n• Herselvraag aanbevolen\n\n🔄 Wachtwoord wijzigen:\n1. Open de kluis\n2. Menu > Wachtwoord wijzigen\n3. Voer oud wachtwoord in\n4. Voer nieuw wachtwoord in en bevestig\n\n❓ Wachtwoord vergeten:\n1. Tik op 'Wachtwoord vergeten?'\n2. Beantwoord de geheime vraag\n3. Maak een nieuw wachtwoord aan\n\n⚠️ Alles vergeten:\nAls je wachtwoord EN antwoord bent vergeten, is de enige optie een volledige reset. Alle gegevens gaan verloren.";

/* Gids - Facturen */
"guide_invoices_title" = "Bonnenbeheer";
"guide_invoices_content" = "Bewaar je aankoopbewijzen digitaal.\n\n🧾 Voor elke uitrusting:\n• Foto van de bon (JPG of PDF)\n• Bonnummer\n• Naam van verkoper/winkel\n• Aanschafdatum (automatisch of handmatig)\n\n🏠 Voor de kluis:\n• Foto van bon/aankoopbewijs\n• Dezelfde informatie\n\n💡 Gebruik:\n• Eigendomsbewijs voor verzekering\n• Garantie-tracking\n• Bewijs bij geschil\n• Export in PDF-fiches\n\n📤 Exporteren:\nBonnen zijn opgenomen in:\n• Uitrusting PDF-fiches\n• Verzekeringsinventaris PDF\n• JSON back-up";

/* Gids - Back-up */
"guide_backup_title" = "Back-up en herstel";
"guide_backup_content" = "Bescherm je gegevens met regelmatige back-ups.\n\n💾 Lokale back-up:\nTik op 'Nu opslaan' in Instellingen. Maakt een lokaal herstelpunt aan.\n\n📤 JSON exporteren:\nExporteer al je gegevens (of selectie) in JSON-formaat:\n• Verstuur via e-mail\n• Sla op in Bestanden\n• Deel via AirDrop\n\n📥 JSON importeren:\nHerstel je gegevens vanuit een eerder geëxporteerd JSON-bestand.\n\n✅ Geëxporteerde gegevens:\n• Uitrusting + foto's\n• Uitleningen en leningen ontvangen\n• Verhuur en reparaties\n• Personen\n• Locaties en bouwplaatsen\n• Handel (producten + transacties)\n• Kluis";

/* Gids - PDF */
"guide_pdf_title" = "PDF-export";
"guide_pdf_content" = "Maak professionele PDF-documenten.\n\n📄 Exporttypes:\n\n📦 Uitrustingscatalogus:\n• Gedetailleerde fiche per item\n• Foto + beschrijving\n• Waarde en opslaglocatie\n• Bonfoto\n\n🔐 Verzekeringsinventaris:\n• Volledige kluislijst\n• Foto's en aankoopbewijzen\n• Totale geschatte waarde\n• Om naar je verzekeraar te sturen\n\n📊 Boekhouding:\n• Operatieoverzicht\n• Inkomsten en uitgaven\n• Per periode (maand/jaar)\n\n💡 Opties:\n• Sluit geretourneerde items uit\n• Kies beeldkwaliteit\n• Selecteer gegevenstypes";

/* Gids - JSON */
"guide_json_title" = "JSON exporteren/importeren";
"guide_json_content" = "Het JSON-formaat is ideaal voor volledige back-ups.\n\n✅ Voordelen:\n• Gestructureerde gegevens\n• Inclusief alle foto's\n• Volledig herstel mogelijk\n• Overdracht tussen apparaten\n\n📤 Exporteren:\n1. Instellingen > Exporteren\n2. Selecteer gegevens\n3. Deel het .json bestand\n\n📥 Importeren:\n1. Instellingen > JSON importeren\n2. Selecteer bestand\n3. Gegevens worden samengevoegd (geen duplicaten)\n\n💡 Tip:\nMaak maandelijks een JSON-export en bewaar op iCloud, Google Drive of via e-mail.\n\n⚠️ Importeren:\nBestaande elementen (zelfde ID) worden niet gedupliceerd.";

/* Gids - Beeldkwaliteit */
"guide_image_quality_title" = "Beeldkwaliteit";
"guide_image_quality_content" = "Optimaliseer de grootte van je exports.\n\n📷 Beschikbare opties:\n\n🟣 Origineel (iPhone):\n• Maximale kwaliteit\n• Zeer grote bestanden (~5 MB)\n• Voor hoge kwaliteit archivering\n\n🔵 Hoog (2000px):\n• Uitstekende kwaliteit\n• Verkleinde grootte (~2 MB)\n• Goed compromis\n\n🟢 Medium (1200px):\n• Goede kwaliteit\n• Lichte bestanden (~800 KB)\n• Aanbevolen ✅\n\n🟠 Laag (800px):\n• Acceptabele kwaliteit\n• Zeer licht (~300 KB)\n• Voor talrijke exports\n\n⚙️ Wijzigen:\nInstellingen > Beeldkwaliteit";

/* Gids - Tips */
"guide_tips_title" = "Praktische tips";
"guide_tips_content" = "Haal het maximale uit de app:\n\n📸 Foto's:\n• Fotografeer elk waardevol item\n• Neem serienummers op\n• Bewaar bonfoto's\n\n👥 Contacten:\n• Maak personen aan voor uitleningen\n• Voer e-mails en telefoons in\n• Gebruik Contacten importeren\n\n📅 Datums:\n• Wees realistisch met retourdata\n• Controleer regelmatig verlopen items\n• Stuur e-mailherinneringen\n\n💾 Back-ups:\n• Exporteer maandelijks JSON\n• Bewaar in de cloud\n• Test een herstel\n\n🔐 Kluis:\n• Inventariseer je waardevolle voorwerpen\n• Bewaar aankoopbewijzen\n• Exporteer voor verzekering";

/* Gids - Beste praktijken */
"guide_best_practices_title" = "Beste praktijken";
"guide_best_practices_content" = "Optimaliseer je dagelijks gebruik:\n\n✅ Wel doen:\n• Maak een foto VOOR het uitlenen\n• Noteer de staat in notities\n• Bevestig retouren snel\n• Houd categorieën consistent\n• Maak regelmatig back-ups\n\n❌ Niet doen:\n• Vergeten retouren te bevestigen\n• Verlopen uitleningen negeren\n• Personen en reparateurs verwarren\n• Bonfoto's verwaarlozen\n\n💡 Ideale workflow:\n1. Maak je opslaglocaties aan\n2. Voeg belangrijke contacten toe\n3. Inventariseer je uitrusting\n4. Fotografeer bonnen\n5. Gebruik dagelijks snel aanmaken";

/* Gids - E-mail */
"guide_email_title" = "E-mails versturen";
"guide_email_content" = "Communiceer eenvoudig met je contacten.\n\n📧 Herinneringse-mail:\n1. Open de fiche van de persoon\n2. Tik op het e-mailicoon\n3. Een vooraf ingevuld bericht opent met:\n   • Lijst van geleende uitrusting\n   • Verwachte retourdata\n   • Vertragingsindicaties\n\n📧 Betalingsherinnering:\nVoor onbetaalde verhuur, stuur een herinnering met verschuldigde bedragen.\n\n✅ Vereisten:\n• E-mail moet ingevuld zijn in de fiche\n• Mail-app moet geconfigureerd zijn\n\n💡 Aanpassen:\nHet bericht opent in Mail, je kunt het bewerken voor verzending.";

/* Gids - Waarschuwingen */
"guide_alerts_title" = "Waarschuwingen en notificaties";
"guide_alerts_content" = "De app waarschuwt je visueel:\n\n🔴 Vertragingsindicatoren:\n• Rode badge op verlopen uitleningen\n• Waarschuwingsdriehoek op leningen ontvangen\n• Rode kleur in lijsten\n\n🟡 Naderende deadlines:\n• 'Binnenkort' filter (< 3 dagen)\n• Oranje kleur\n\n💰 Betalingen:\n• Sectie 'Naderende betalingen'\n• Sectie 'Verlopen betalingen'\n• Handelswaarschuwingen voor vervaldatums\n\n📦 Lage voorraad:\n• Badge op items in waarschuwing\n• Zichtbaar in Handel\n\n💡 Tip:\nControleer regelmatig de 'Verlopen' en 'Binnenkort' filters om vooruit te plannen.";

/* Gids - Capaciteit */
"guide_capacity_title" = "Capaciteit en limieten";
