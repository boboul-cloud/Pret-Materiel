/* Guide - AI Scanner */
"guide_scanner_intro_title" = "Smart Scanner";
"guide_scanner_intro_content" = "The AI scanner uses OpenAI Vision technology (GPT-4o) to automatically identify your equipment from a photo. It recognizes the type of object, brand, model and suggests an appropriate category.";
"guide_scanner_apikey_title" = "OpenAI API Key Required";
"guide_scanner_apikey_content" = "To use this feature, you need an OpenAI API key:\n\n1. Create an account at platform.openai.com\n2. Go to API Keys and create a new key\n3. Copy the key (starts with 'sk-')\n4. Paste it in the app when first using the scanner\n\nYour key is stored only on your device and is never shared.";
"guide_scanner_cost_title" = "Usage Costs";
"guide_scanner_cost_content" = "Using the OpenAI API is paid:\n\n• About $0.003 to $0.01 per analyzed photo\n• Charges are billed directly to your OpenAI account\n• You can set spending limits at platform.openai.com\n• Check your usage regularly in your OpenAI dashboard\n\nThe app has no access to your payment information.";
"guide_scanner_howto_title" = "How It Works";
"guide_scanner_howto_content" = "1. Tap 'Scan with AI' in the equipment list\n2. Take a photo or choose an existing image\n3. Tap 'Identify with AI'\n4. The image is sent to OpenAI for analysis\n5. Fields are automatically pre-filled\n6. Review and modify if needed\n7. Create the equipment";
"guide_scanner_tips_title" = "Tips for Better Results";
"guide_scanner_tips_content" = "• Take the photo in a well-lit area\n• Frame the entire object in the image\n• If possible, include the label or brand logo\n• Avoid blurry or too dark photos\n• A neutral background improves recognition";
"guide_scanner_internet_title" = "Internet Connection Required";
"guide_scanner_internet_content" = "The AI scanner requires an internet connection to work. The image is sent to OpenAI servers for analysis. Without a connection, you can still add your equipment manually.";
"guide_scanner_privacy_title" = "Privacy";
"guide_scanner_privacy_content" = "• Your API key is stored locally on your device\n• Images are sent directly to OpenAI (no intermediate server)\n• See OpenAI's privacy policy for more information\n• You can delete your key at any time in the scanner settings";

/* Guide - Introduction */
"guide_intro_title" = "Welcome to Equipment";
"guide_intro_content" = "Equipment is your complete assistant for managing everything you lend, borrow, rent or sell.\n\n📦 Inventory: Catalog your equipment with photos and receipts\n🔄 Loans/Borrows: Track who has what and until when\n💰 Rentals: Rent your equipment and manage payments\n🛒 Commerce: Manage your purchases and sales with VAT\n🔐 Safe Box: Protect your important documents\n📊 Accounting: Track your income and expenses\n\nNavigate between tabs at the bottom to access different features.";

/* Guide - Home */
"guide_home_title" = "Home Page";
"guide_home_content" = "The home page gives you quick access to main actions:\n\n📸 Quick Loan: Photograph an item you're lending, add info and you're done!\n\n📸 Quick Borrow: Someone lending you something? Note it in seconds.\n\n👑 Go Premium: Free version has limited items. Premium unlocks everything unlimited.\n\nQuick buttons automatically create equipment and contacts if needed.";

/* Guide - Quick Create */
"guide_quick_create_title" = "Quick Creation with Photo";
"guide_quick_create_content" = "Quick creation is the easiest way to start:\n\n1️⃣ Tap 'Create quick loan' or 'Create quick borrow'\n2️⃣ Take a photo of the item (optional but recommended)\n3️⃣ Enter the item name\n4️⃣ Add the person's name\n5️⃣ Set the expected return date\n6️⃣ Confirm!\n\nThe app automatically creates:\n• The equipment card with photo\n• The contact if new\n• The loan or borrow with dates\n\nYou can edit these elements anytime.";

/* Guide - Navigation */
"guide_navigation_title" = "Navigating the App";
"guide_navigation_content" = "The app is organized in 5 main tabs:\n\n🏠 Home: Quick actions and overview\n\n📦 Equipment: Your complete inventory with filters by category, location and status\n\n↗️ Loans: What you lend to others (filterable by status: Ongoing, Late, Returned)\n\n↙️ Borrowed: What others lend to you (same filters available)\n\n⚙️ Other: People, Locations, Worksites, Rentals, Repairs, Commerce, Accounting, Safe Box and Settings\n\nEach list is searchable and sortable.";

/* Guide - Language */
"guide_language_title" = "Change Language";
"guide_language_content" = "The app is available in 7 languages:\n🇫🇷 Français\n🇬🇧 English\n🇩🇪 Deutsch\n🇪🇸 Español\n🇮🇹 Italiano\n🇵🇹 Português\n🇳🇱 Nederlands\n\nTo change language:\n1. Go to Other > Settings\n2. Select your language flag\n\nThe language is applied instantly throughout the app.";

/* Guide - Equipment */
"guide_equipment_title" = "Manage Your Equipment";
"guide_equipment_content" = "The Equipment tab is your central inventory:\n\n➕ Add equipment:\n• Name and detailed description\n• Category (create your own)\n• Estimated value in €\n• Acquisition date\n• Storage location (optional)\n• Precise location (e.g., top shelf)\n• Photo of the item\n• Receipt photo with number and seller\n\n🔍 Filter your inventory:\n• By category (Tools, Sports, Kitchen...)\n• By storage location\n• By status (Available, Loaned, Rented)\n• By text search\n\n📊 View details:\n• Loan history\n• Rental history\n• Repair history";

/* Guide - Photos */
"guide_photos_title" = "Photos and Receipts";
"guide_photos_content" = "Photos enrich your cards:\n\n📷 Equipment photo:\n• Visually identify the item\n• Visible in lists and PDF exports\n• Take directly or choose from gallery\n\n🧾 Receipt photo:\n• Important proof of purchase\n• Receipt number and seller (optional)\n• Useful for insurance or warranty\n• Exportable to PDF\n\n💡 Quality tip:\nIn Settings > Image Quality, choose:\n• Original: Max quality, heavy files\n• High: Good compromise\n• Medium: Recommended (light and sufficient)\n• Low: To save space";

/* Guide - Loans */
"guide_loans_title" = "Create and Manage Loans";
"guide_loans_content" = "A loan = equipment you entrust to someone.\n\n➕ Create a loan:\n1. Select the equipment to lend\n2. Choose the borrower (or create one)\n3. Set dates (start and expected end)\n4. Add notes if needed\n\n📋 Loan statuses:\n🟢 Ongoing: Active loan, no delay\n🟡 Soon: Due in less than 3 days\n🔴 Late: End date passed\n✅ Returned: Equipment given back\n\n✔️ Confirm a return:\nTap 'Confirm return' on the loan card. The actual return date is recorded.\n\n📧 Follow up with a borrower:\nFrom the person's card, send a summary email of items in progress.";

/* Guide - Borrows */
"guide_borrows_title" = "Track Your Borrows";
"guide_borrows_content" = "A borrow = something someone lends to you.\n\n➕ Create a borrow:\n1. Name the borrowed item\n2. Select the lender (person lending to you)\n3. Set start and expected return dates\n4. Take a photo of the item\n5. Add notes (condition, terms...)\n\n🔄 Actions on a borrow:\n• Lend it to someone else\n• Rent it out (subletting)\n• Send it for repair\n• Return it to the lender\n\n📦 Create in Equipment:\nCheck this option to add the borrowed item to your inventory. It will be automatically removed when you return it.\n\n⚠️ Blocking:\nYou cannot return a borrow if it's currently loaned, rented or being repaired.";

/* Guide - Lend Borrow */
"guide_lend_borrow_title" = "Lend a Borrowed Item";
"guide_lend_borrow_content" = "Want to temporarily lend something you borrowed?\n\n📤 How to:\n1. Go to the borrow card\n2. Tap 'Lend'\n3. Select the person you're lending to\n4. Set the expected return date\n\n⚠️ Blocking rules:\n• The borrow cannot be returned while the loan is active\n• You must first recover the item from the loan\n• Then you can return the borrow\n\n🔄 Same logic for:\n• Renting a borrow (subletting)\n• Sending a borrow for repair\n\nThis allows complete tracking of the possession chain.";

/* Guide - Repairs */
"guide_repairs_title" = "Manage Repairs";
"guide_repairs_content" = "Send your equipment for repair and track costs.\n\n🔧 Create a repair:\n1. Select the equipment to repair\n2. Choose a repairer ('Repairer' type required)\n3. Describe the problem\n4. Enter estimated cost\n5. Set expected return date\n\n📊 Tracking:\n• Status: In progress / Completed\n• Estimated vs final cost\n• Delay indicator if overdue\n\n✅ Complete a repair:\n1. Confirm the return\n2. Enter final cost\n3. Mark as 'Paid' when settled\n\n💰 Accounting:\nRepairs are automatically recorded as expenses.";

/* Guide - Returns */
"guide_return_title" = "Confirm Returns";
"guide_return_content" = "When an item is returned, confirm the return:\n\n✅ For a loan:\nTap 'Confirm return'. The equipment becomes available again.\n\n✅ For a borrow:\nTap 'Confirm return'. The borrow is marked as returned.\n\n✅ For a rental:\nTap 'End rental'. You'll then need to:\n• Mark payment as received\n• Handle deposit (return or keep)\n\n✅ For a repair:\nTap 'Confirm repair return'. Enter the final cost.\n\n💡 Tip:\nReturns are timestamped. You'll find the complete history in each card.";

/* Guide - Rentals */
"guide_rentals_title" = "Rent Your Equipment";
"guide_rentals_content" = "Rentals let you rent your equipment for payment.\n\n➕ Create a rental:\n1. Select the equipment to rent\n2. Choose the renter\n3. Set the rate type:\n   • Day (price × number of days)\n   • Week (price × number of weeks)\n   • Month (price × number of months)\n   • Fixed price\n4. Enter the deposit amount\n5. Set the dates\n\n📊 Dashboard:\n• Income received (confirmed payments)\n• Pending (not yet paid)\n\n✅ End a rental:\n1. End the rental when item is returned\n2. Confirm payment receipt\n3. Handle deposit (return or keep)";

/* Guide - Deposits */
"guide_caution_title" = "Manage Deposits";
"guide_caution_content" = "The deposit is a guarantee collected at end of rental.\n\n💵 Types of actions:\n\n🔙 Return deposit:\nIf everything is OK, return the deposit to the renter. It doesn't count as income.\n\n⚠️ Keep deposit:\nIn case of damage or dispute, keep all or part. The kept amount is added to your income.\n\n📋 Tracking in 'Other':\nThe 'Deposits to return' section lists all completed rentals with pending deposit handling.\n\n💰 Accounting:\nOnly kept deposits appear in accounting as exceptional income.";

/* Guide - Sublet */
"guide_sublet_title" = "Sublet Equipment";
"guide_sublet_content" = "You can sublet equipment you're renting yourself.\n\n📤 How to:\n1. Go to your active rental card\n2. Tap 'Sublet'\n3. Select the subletter\n4. Set your own rates and terms\n\n⚠️ Rules:\n• The main rental cannot be ended while the sublet is active\n• First recover the equipment from the sublet\n• Then end the main rental\n\n💰 Income:\nSublet income is added to your normal accounting.";

/* Guide - I Rent (My Rentals) */
"guide_myrentals_title" = "I Rent - Equipment I'm Renting";
"guide_myrentals_content" = "The 'I Rent' section lets you manage equipment YOU are renting from someone else (external equipment rental).\n\n📤 Create a rental:\n1. Tap 'Add a rental'\n2. Name the rented equipment\n3. Select the lessor (who you're renting from)\n4. Set the rate type (day/week/month/flat rate)\n5. Enter the price and deposit paid\n6. Set start and end dates\n\n📊 Tracking:\n• Total rental amount\n• Deposit paid and recovered\n• Status: In progress, Late, Completed\n• Payment made or pending\n\n✅ End a rental:\n1. Mark the rental as completed\n2. Enter the deposit amount recovered\n3. Confirm payment made\n\n⚠️ Reminders:\nRentals with unrecovered deposits appear as alerts.";

/* Guide - My Deposits */
"guide_myrentals_caution_title" = "Managing My Deposits Paid";
"guide_myrentals_caution_content" = "When you rent equipment, you often pay a deposit.\n\n💵 Deposit tracking:\n• Deposit amount paid at signing\n• Amount recovered at end of rental\n• Difference if any retention\n\n🔄 Workflow:\n1. When creating, enter the deposit paid\n2. At end of rental, enter amount recovered\n3. The difference is automatically calculated\n\n📋 Alerts:\nIn 'Other > I Rent', an alert warns you if completed rentals have unrecovered deposits.\n\n💰 Accounting:\n• Deposit paid = temporary expense\n• Deposit recovered = refund\n• Unrecovered deposit = loss (permanent expense)";

/* Guide - Commerce */
"guide_commerce_title" = "Buy/Sell Module";
"guide_commerce_content" = "The Commerce module is ideal for markets, shops and small businesses.\n\n📦 Features:\n• Product catalog with purchase and selling prices\n• Automatic stock management\n• VAT calculation (collected, deductible, payable)\n• Percentage or fixed discounts\n• Payment methods (cash, card, check, transfer)\n• Deferred payments with reminders\n\n📊 Commercial accounting:\n• Total sales / purchases / profits\n• VAT detail by rate\n• Average basket\n• Payment method breakdown\n• Low stock alerts\n\n🔄 JSON export/import to backup your data.";

/* Guide - Articles */
"guide_articles_title" = "Manage Your Products";
"guide_articles_content" = "Products are items in your commercial catalog.\n\n➕ Create a product:\n• Name and description\n• Category (create your own)\n• Reference / SKU\n• Purchase price excluding VAT and purchase VAT rate\n• Selling price including VAT and sales VAT rate\n• Current stock and alert threshold\n• Supplier (optional)\n• Photo (optional)\n\n📊 Automatic margin:\nThe app automatically calculates your margin and percentage.\n\n🔔 Stock alerts:\nWhen stock falls below threshold, the item appears in alerts.\n\n⚡ Quick sale:\nLong-press a product for quick sale without complex entry.";

/* Guide - Transactions */
"guide_transactions_title" = "Record Transactions";
"guide_transactions_content" = "Transactions are your sales and purchases.\n\n🛒 Create a transaction:\n1. Choose type: Sale or Purchase\n2. Select a catalog item OR enter freely\n3. Enter quantity\n4. Apply discount (optional): % or fixed amount\n5. Choose payment method: Cash, Card, Check, Transfer\n6. Indicate if paid or pending\n7. If pending, set payment date\n\n📊 Automatic summary:\n• Gross amount excluding VAT\n• Applied discount\n• Net amount excluding VAT\n• Calculated VAT\n• Total including VAT\n\n🔔 Reminders:\nEnable notifications for upcoming payments (3 days before).";

/* Guide - Accounting */
"guide_accounting_title" = "Rental Accounting";
"guide_accounting_content" = "Accounting automatically groups your financial operations.\n\n📊 Content:\n• Income: Paid rentals\n• Income: Kept deposits\n• Expenses: Paid repairs\n\n📅 Periods:\n• View by month\n• View by year\n• Total view\n\n💰 Indicators:\n• Total income (green)\n• Total expenses (red)\n• Net profit\n\n📤 Export:\n• Formatted PDF for accounting\n• JSON for backup/import\n\nOperations are automatically added when you mark a payment as received.";

/* Guide - Commerce Accounting */
"guide_commerce_accounting_title" = "Commercial Accounting";
"guide_commerce_accounting_content" = "Complete view of your sales activity.\n\n📊 Dashboard:\n• Total sales including VAT\n• Total purchases including VAT\n• Net profit\n• Average basket (sales and purchases)\n\n💹 Detailed VAT:\n• Collected VAT (on sales)\n• Deductible VAT (on purchases)\n• VAT payable (difference)\n• Detail by rate (5.5%, 10%, 20%...)\n\n💳 Payment breakdown:\n• Cash / Card / Check / Transfer\n• Percentage visualization\n\n📦 Stock:\n• Number of items in stock\n• Items in alert (low stock)\n\n💸 Discounts given:\n• Total sales discounts\n• Total purchase discounts";

/* Guide - People */
"guide_people_title" = "Contact List";
"guide_people_content" = "Manage people you interact with.\n\n➕ Add a person:\n• First and last name\n• Email (enables email sending)\n• Phone (enables direct calls)\n• Organization (company, association...)\n• Type: Person, Repairer or Employee\n• Photo (optional)\n\n📧 Reminder email:\nFrom a person's card, send an email automatically listing:\n• Equipment currently loaned\n• Expected return dates\n• Delay indications\n\n📞 Direct call:\nTap the phone number to call directly.\n\n📇 Import Contacts:\nAutomatically import from your iPhone contacts.";

/* Guide - People Types */
"guide_people_types_title" = "People Types";
"guide_people_types_content" = "Three types to organize your contacts:\n\n👤 Person (default):\nClients, friends, family... Anyone you lend or rent equipment to.\n\n🔧 Repairer:\nCraftsmen and repair shops. Only repairers can be selected when sending for repair.\n\n👷 Employee:\nTeam members. Can be assigned to worksites. Ideal for companies with multiple sites.\n\n💡 Tip:\nA person can only have one type. Change it anytime from their card.";

/* Guide - Duplicates */
"guide_duplicates_title" = "Merge Duplicates";
"guide_duplicates_content" = "The app automatically detects duplicate people.\n\n🔍 How it works:\n• Detection by identical first + last name\n• Ignores case and spaces\n\n🔄 Merge:\n1. Go to Other > People\n2. Tap the 'Duplicates' button in the toolbar\n3. Select the duplicate group\n4. Choose the person to keep\n5. Confirm the merge\n\n✅ Result:\n• All loans are reassigned\n• All borrows are reassigned\n• All rentals are reassigned\n• Duplicates are deleted\n\n💡 Check the contact info of the kept person.";

/* Guide - Worksites */
"guide_worksites_title" = "Worksite Management";
"guide_worksites_content" = "Organize your team across multiple work sites.\n\n🏗️ Create a worksite:\n• Worksite name\n• Full address\n• Description and notes\n• Start and end dates\n• Main site contact\n• Status: Active or Completed\n\n👷 Assign employees:\n1. Create 'Employee' type people\n2. Open the worksite card\n3. Add the relevant employees\n\n🗺️ Navigation:\nTap the address to open in Maps.\n\n📊 Automatic statuses:\n• Preparing: Start date not reached\n• Active: In progress\n• Completed: Marked as finished\n\n📤 Export to PDF or JSON.";

/* Guide - Locations */
"guide_locations_title" = "Storage Locations";
"guide_locations_content" = "Organize where your equipment is stored.\n\n📍 Create a location:\n• Name (e.g., Garage, North Warehouse...)\n• Full address\n• Building\n• Floor\n• Room\n• Notes\n\n📦 Usage:\n• Associate each equipment with a location\n• Add precise placement (e.g., shelf B, drawer 3)\n• Filter your inventory by location\n\n🔍 Find an item:\n1. Search for it in Equipment\n2. The card shows location and exact placement\n\n📊 Overview:\nA location's card shows all equipment stored there.";

/* Guide - Categories */
"guide_categories_title" = "Manage Categories";
"guide_categories_content" = "Categories organize your inventory.\n\n➕ Create a category:\nWhen adding equipment, type a new category name.\n\n🗂️ Suggested categories:\n• Tools\n• Electronics\n• Sports\n• Kitchen\n• Gardening\n• DIY\n• Music\n• Photo/Video\n\n📝 Manage categories:\n1. In the Equipment list\n2. Tap the folder icon near the category filter\n3. Rename or delete\n\n⚠️ Delete a category:\nEquipment is not deleted, they just lose their category.";

/* Guide - Search */
"guide_search_title" = "Search and Filters";
"guide_search_content" = "Quickly find any item.\n\n🔍 Search bar:\n• Available on every list\n• Searches name and description\n• Real-time results\n\n🎯 Combinable filters:\n\n📦 Equipment:\n• By category\n• By storage location\n• By status (Available, Loaned, Rented)\n\n↗️ Loans / ↙️ Borrows:\n• All / Ongoing / Late / Returned / Soon\n\n🏷️ Rentals:\n• By status\n• By payment state\n• By deposit state\n\n🔧 Repairs:\n• In progress / Completed\n• Paid / Unpaid\n\n💡 Reset button:\nReset all filters with one tap.";

/* Guide - Status */
"guide_status_title" = "Understanding Statuses";
"guide_status_content" = "Color codes throughout the app:\n\n🟢 Green:\n• Available\n• Returned\n• Paid\n• Completed\n\n🟡 Orange:\n• Ongoing\n• Soon (< 3 days)\n• Awaiting payment\n\n🔴 Red:\n• Late\n• Unpaid (date passed)\n• Problem detected\n\n🔵 Blue:\n• Information\n• Clickable link\n• Available action\n\n📊 Visual indicators:\n• Clock icon: Ongoing\n• Triangle icon: Late\n• Check icon: Completed/Returned\n• Number badge: Item count";

/* Guide - Safe */
"guide_safe_title" = "Secure Safe Box";
"guide_safe_content" = "Protect your important documents with secure access.\n\n🔐 Setup:\n1. Create a password (min. 4 characters)\n2. Choose a recovery question\n3. Answer the secret question\n\n📦 Recommended content:\n• Valuable jewelry and watches\n• Expensive electronics\n• Artwork\n• Important documents\n• Major purchase receipts\n\n🏷️ For each item:\n• Photo of the item\n• Name and description\n• Estimated value\n• Brand, model, serial number\n• Receipt/proof of purchase photo\n\n📄 Insurance inventory:\nExport a complete PDF for your insurer.";

/* Guide - Biometric */
"guide_biometric_title" = "Face ID / Touch ID";
"guide_biometric_content" = "Access the safe box with biometrics.\n\n✅ Advantages:\n• Quick access without entering password\n• Enhanced security\n• Same protection level as your iPhone\n\n🔧 Activation:\nBiometric authentication is automatic if your device supports it.\n\n📱 Compatibility:\n• Face ID (iPhone X and later)\n• Touch ID (iPhone with sensor)\n\n🔑 Fallback:\nIf biometrics fails, enter your password.\n\n⚠️ Forgotten password:\n1. Use the recovery question\n2. Last resort: complete reset (data loss)";

/* Guide - Password */
"guide_password_title" = "Password Management";
"guide_password_content" = "Secure your safe box with a strong password.\n\n🔑 Rules:\n• Minimum 4 characters\n• Confirmation required\n• Recovery question recommended\n\n🔄 Change password:\n1. Open the safe box\n2. Menu > Change password\n3. Enter old password\n4. Enter and confirm new one\n\n❓ Forgotten password:\n1. Tap 'Forgot password?'\n2. Answer the secret question\n3. Create a new password\n\n⚠️ Everything forgotten:\nIf you forgot both password AND answer, the only option is complete reset. All data will be lost.";

/* Guide - Invoices */
"guide_invoices_title" = "Receipt Management";
"guide_invoices_content" = "Keep your purchase proofs digitally.\n\n🧾 For each equipment:\n• Receipt photo (JPG or PDF)\n• Receipt number\n• Seller/store name\n• Acquisition date (automatic or manual)\n\n🏠 For the safe box:\n• Receipt/proof of purchase photo\n• Same information\n\n💡 Uses:\n• Proof of ownership for insurance\n• Warranty tracking\n• Evidence in case of dispute\n• Export in PDF cards\n\n📤 Export:\nReceipts are included in:\n• Equipment PDF cards\n• Insurance inventory PDF\n• JSON backup";

/* Guide - Backup */
"guide_backup_title" = "Backup and Restore";
"guide_backup_content" = "Protect your data with regular backups.\n\n💾 Local backup:\nTap 'Save now' in Settings. Creates a local restore point.\n\n📤 JSON export:\nExport all your data (or selection) in JSON format:\n• Send by email\n• Save in Files\n• Share via AirDrop\n\n📥 JSON import:\nRestore your data from a previously exported JSON file.\n\n✅ Exported data:\n• Equipment + photos\n• Loans and borrows\n• Rentals and repairs\n• People\n• Locations and worksites\n• Commerce (products + transactions)\n• Safe box";

/* Guide - PDF */
"guide_pdf_title" = "PDF Export";
"guide_pdf_content" = "Create professional PDF documents.\n\n📄 Export types:\n\n📦 Equipment Catalog:\n• Detailed card per item\n• Photo + description\n• Value and storage location\n• Receipt photo\n\n🔐 Insurance Inventory:\n• Complete safe box list\n• Photos and purchase proofs\n• Total estimated value\n• To send to your insurer\n\n📊 Accounting:\n• Operations summary\n• Income and expenses\n• By period (month/year)\n\n💡 Options:\n• Exclude returned items\n• Choose image quality\n• Select data types";

/* Guide - JSON */
"guide_json_title" = "JSON Export/Import";
"guide_json_content" = "JSON format is ideal for complete backups.\n\n✅ Advantages:\n• Structured data\n• Includes all photos\n• Complete restoration possible\n• Transfer between devices\n\n📤 Export:\n1. Settings > Export\n2. Select data\n3. Share the .json file\n\n📥 Import:\n1. Settings > Import JSON\n2. Select file\n3. Data is merged (no duplicates)\n\n💡 Tip:\nMake a monthly JSON export and store it on iCloud, Google Drive or by email.\n\n⚠️ Import:\nExisting elements (same ID) are not duplicated.";

/* Guide - Image Quality */
"guide_image_quality_title" = "Image Quality";
"guide_image_quality_content" = "Optimize your export size.\n\n📷 Available options:\n\n🟣 Original (iPhone):\n• Maximum quality\n• Very large files (~5 MB)\n• For high-quality archiving\n\n🔵 High (2000px):\n• Excellent quality\n• Reduced size (~2 MB)\n• Good compromise\n\n🟢 Medium (1200px):\n• Good quality\n• Light files (~800 KB)\n• Recommended ✅\n\n🟠 Low (800px):\n• Acceptable quality\n• Very light (~300 KB)\n• For numerous exports\n\n⚙️ Change:\nSettings > Image Quality";

/* Guide - Tips */
"guide_tips_title" = "Practical Tips";
"guide_tips_content" = "Get the most out of the app:\n\n📸 Photos:\n• Photograph every valuable item\n• Include serial numbers\n• Keep receipt photos\n\n👥 Contacts:\n• Create people before loans\n• Enter emails and phones\n• Use Contact import\n\n📅 Dates:\n• Be realistic about return dates\n• Regularly check delays\n• Send email reminders\n\n💾 Backups:\n• Export JSON monthly\n• Store in the cloud\n• Test a restore\n\n🔐 Safe box:\n• Inventory your valuables\n• Keep purchase proofs\n• Export for insurance";

/* Guide - Best Practices */
"guide_best_practices_title" = "Best Practices";
"guide_best_practices_content" = "Optimize your daily use:\n\n✅ Do:\n• Take a photo BEFORE lending\n• Note condition in notes\n• Confirm returns quickly\n• Keep categories consistent\n• Make regular backups\n\n❌ Avoid:\n• Forgetting to confirm returns\n• Ignoring late loans\n• Mixing people and repairers\n• Neglecting receipt photos\n\n💡 Ideal workflow:\n1. Create your storage locations\n2. Add key contacts\n3. Inventory your equipment\n4. Photograph receipts\n5. Use quick creation daily";

/* Guide - Email */
"guide_email_title" = "Sending Emails";
"guide_email_content" = "Easily communicate with your contacts.\n\n📧 Reminder email:\n1. Open the person's card\n2. Tap the email icon\n3. A pre-filled message opens with:\n   • List of loaned equipment\n   • Expected return dates\n   • Delay indications\n\n📧 Payment reminder:\nFor unpaid rentals, send a reminder listing amounts due.\n\n✅ Requirements:\n• Email must be entered in the card\n• Mail app must be configured\n\n💡 Customize:\nThe message opens in Mail, you can edit before sending.";

/* Guide - Alerts */
"guide_alerts_title" = "Alerts and Notifications";
"guide_alerts_content" = "The app alerts you visually:\n\n🔴 Delay indicators:\n• Red badge on late loans\n• Warning triangle on borrows\n• Red color in lists\n\n🟡 Upcoming deadlines:\n• 'Soon' filter (< 3 days)\n• Orange color\n\n💰 Payments:\n• 'Upcoming payments' section\n• 'Late payments' section\n• Commerce alerts for deadlines\n\n📦 Low stock:\n• Badge on items in alert\n• Visible in Commerce\n\n💡 Tip:\nRegularly check 'Late' and 'Soon' filters to anticipate.";

/* Guide - Capacity */
"guide_capacity_title" = "Capacity and Limits";
"guide_capacity_content" = "Free version vs Premium:\n\n🆓 Free version:\n• 10 equipment\n• 5 active loans\n• 5 active borrows\n• 5 rentals\n• 5 repairs\n• 10 people\n• 3 locations\n• 5 safe box items\n\n👑 Premium version:\n• Everything UNLIMITED!\n• One-time payment, lifetime access\n• Support development\n\n💾 Storage:\n• Local data on your iPhone\n• No technical limit\n• Photos take up more space\n\n💡 Tip:\nMake regular backups, especially with lots of data.";

/* Guide - Premium */
"guide_premium_title" = "Go Premium";
"guide_premium_content" = "Unlock the app's full potential.\n\n👑 Premium advantages:\n• Unlimited equipment\n• Unlimited loans\n• Unlimited borrows\n• Unlimited rentals\n• Unlimited repairs\n• Unlimited people\n• Unlimited locations\n• Unlimited safe box\n\n💳 Payment:\n• One-time payment\n• Lifetime access\n• No subscription\n\n🔄 Restore:\nIf you change devices:\n1. Go to Premium\n2. Tap 'Restore purchases'\n3. Your purchases are restored\n\n❤️ Support:\nYour purchase helps improve the app!";

/* Guide - FAQ */
"guide_faq_title" = "Frequently Asked Questions";
"guide_faq_content" = "❓ Is my data secure?\nYes, everything is stored locally on your iPhone. The safe box is password protected.\n\n❓ Can I use the app on iPad/Mac?\nYes, the app is universal and works on iPhone, iPad and Mac (Apple Silicon).\n\n❓ How do I transfer my data?\nExport to JSON, then import on the new device.\n\n❓ Does the app work offline?\nYes, all features are available without internet.\n\n❓ How do I contact support?\nSend an email from the App Store page or Settings.\n\n❓ Are updates free?\nYes, all updates are included.";

