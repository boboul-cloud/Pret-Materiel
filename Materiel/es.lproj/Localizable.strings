/* Guía - Prestar un objeto prestado */
"guide_lend_borrow_title" = "Prestar un objeto prestado";
"guide_lend_borrow_content" = "¿Has pedido prestado algo y quieres prestarlo temporalmente? Usa el botón 'Prestar' en cada préstamo activo. El préstamo quedará bloqueado para devolución hasta que se recupere. También puedes marcar 'Crear en Materiales' al crear un préstamo para añadirlo a tu inventario - se eliminará automáticamente al devolverlo.";

/* Guía - Alquileres de pago */
"guide_rentals_title" = "Alquilar tu material";
"guide_rentals_content" = "La pestaña 'Alquileres' te permite alquilar tu material por dinero. Define una tarifa (día/semana/mes/fijo), una fianza y sigue los pagos. El resumen financiero muestra tus ingresos recibidos y pendientes. Finaliza el alquiler cuando se devuelva el artículo, luego gestiona la devolución de la fianza.";

/* Guía - Alquilar un objeto prestado */
"guide_sublet_title" = "Alquilar un objeto prestado";
"guide_sublet_content" = "¿Has pedido prestado algo y quieres alquilarlo temporalmente? Usa el botón 'Alquilar' en cada préstamo recibido activo. El préstamo quedará bloqueado para devolución hasta que se recupere el alquiler. Define tus propias tarifas y condiciones. Primero recupera el material del alquiler antes de poder devolver tu préstamo.";

/* Guía - Gestión de duplicados */
"guide_duplicates_title" = "Fusionar duplicados";
"guide_duplicates_content" = "La aplicación detecta automáticamente personas duplicadas (mismo nombre/apellido). Ve a 'Otros > Personas' y pulsa el botón 'Duplicados' en la barra de herramientas. Selecciona el grupo a fusionar: todos los préstamos serán reasignados a la persona conservada, las demás serán eliminadas.";

