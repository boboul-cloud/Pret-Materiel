/* Guía - Escáner IA */
"guide_scanner_intro_title" = "Escáner Inteligente";
"guide_scanner_intro_content" = "El escáner IA utiliza la tecnología OpenAI Vision (GPT-4o) para identificar automáticamente tu equipo a partir de una foto. Reconoce el tipo de objeto, marca, modelo y sugiere una categoría apropiada.";
"guide_scanner_apikey_title" = "Clave API de OpenAI Requerida";
"guide_scanner_apikey_content" = "Para usar esta función, necesitas una clave API de OpenAI:\n\n1. Crea una cuenta en platform.openai.com\n2. Ve a API Keys y crea una nueva clave\n3. Copia la clave (comienza con 'sk-')\n4. Pégala en la app al usar el escáner por primera vez\n\nTu clave se almacena solo en tu dispositivo y nunca se comparte.";
"guide_scanner_cost_title" = "Costos de Uso";
"guide_scanner_cost_content" = "El uso de la API de OpenAI es de pago:\n\n• Aproximadamente $0.003 a $0.01 por foto analizada\n• Los cargos se facturan directamente a tu cuenta de OpenAI\n• Puedes establecer límites de gasto en platform.openai.com\n• Revisa tu uso regularmente en tu panel de OpenAI\n\nLa app no tiene acceso a tu información de pago.";
"guide_scanner_howto_title" = "Cómo Funciona";
"guide_scanner_howto_content" = "1. Toca 'Escanear con IA' en la lista de equipos\n2. Toma una foto o elige una imagen existente\n3. Toca 'Identificar con IA'\n4. La imagen se envía a OpenAI para análisis\n5. Los campos se rellenan automáticamente\n6. Revisa y modifica si es necesario\n7. Crea el equipo";
"guide_scanner_tips_title" = "Consejos para Mejores Resultados";
"guide_scanner_tips_content" = "• Toma la foto en un área bien iluminada\n• Encuadra todo el objeto en la imagen\n• Si es posible, incluye la etiqueta o logo de la marca\n• Evita fotos borrosas o demasiado oscuras\n• Un fondo neutro mejora el reconocimiento";
"guide_scanner_internet_title" = "Conexión a Internet Requerida";
"guide_scanner_internet_content" = "El escáner IA requiere conexión a internet para funcionar. La imagen se envía a los servidores de OpenAI para análisis. Sin conexión, aún puedes agregar tu equipo manualmente.";
"guide_scanner_privacy_title" = "Privacidad";
"guide_scanner_privacy_content" = "• Tu clave API se almacena localmente en tu dispositivo\n• Las imágenes se envían directamente a OpenAI (sin servidor intermedio)\n• Consulta la política de privacidad de OpenAI para más información\n• Puedes eliminar tu clave en cualquier momento en los ajustes del escáner";

/* Guía - Introducción */
"guide_intro_title" = "Bienvenido a Material";
"guide_intro_content" = "Material es tu asistente completo para gestionar todo lo que prestas, tomas prestado, alquilas o vendes.\n\n📦 Inventario: Cataloga tu equipo con fotos y recibos\n🔄 Préstamos: Rastrea quién tiene qué y hasta cuándo\n💰 Alquileres: Alquila tu equipo y gestiona pagos\n🛒 Comercio: Gestiona tus compras y ventas con IVA\n🔐 Caja fuerte: Protege tus documentos importantes\n📊 Contabilidad: Rastrea tus ingresos y gastos\n\nNavega entre las pestañas inferiores para acceder a las diferentes funciones.";

/* Guía - Página de inicio */
"guide_home_title" = "Página de inicio";
"guide_home_content" = "La página de inicio te da acceso rápido a las acciones principales:\n\n📸 Préstamo rápido: Fotografía un artículo que prestas, añade info ¡y listo!\n\n📸 Préstamo recibido rápido: ¿Alguien te presta algo? Anótalo en segundos.\n\n👑 Hazte Premium: La versión gratuita tiene artículos limitados. Premium desbloquea todo ilimitado.\n\nLos botones rápidos crean automáticamente equipos y contactos si es necesario.";

/* Guía - Creación rápida */
"guide_quick_create_title" = "Creación rápida con foto";
"guide_quick_create_content" = "La creación rápida es la forma más fácil de empezar:\n\n1️⃣ Toca 'Crear préstamo rápido' o 'Crear préstamo recibido rápido'\n2️⃣ Toma una foto del artículo (opcional pero recomendado)\n3️⃣ Introduce el nombre del artículo\n4️⃣ Añade el nombre de la persona\n5️⃣ Establece la fecha de devolución esperada\n6️⃣ ¡Confirma!\n\nLa app crea automáticamente:\n• La ficha del equipo con foto\n• El contacto si es nuevo\n• El préstamo con fechas\n\nPuedes editar estos elementos en cualquier momento.";

/* Guía - Navegación */
"guide_navigation_title" = "Navegar por la app";
"guide_navigation_content" = "La app está organizada en 5 pestañas principales:\n\n🏠 Inicio: Acciones rápidas y resumen\n\n📦 Material: Tu inventario completo con filtros por categoría, lugar y estado\n\n↗️ Préstamos: Lo que prestas a otros (filtrable por estado: En curso, Atrasado, Devuelto)\n\n↙️ Prestados: Lo que otros te prestan (mismos filtros disponibles)\n\n⚙️ Otros: Personas, Lugares, Obras, Alquileres, Reparaciones, Comercio, Contabilidad, Caja fuerte y Ajustes\n\nCada lista es buscable y ordenable.";

/* Guía - Idioma */
"guide_language_title" = "Cambiar idioma";
"guide_language_content" = "La app está disponible en 7 idiomas:\n🇫🇷 Français\n🇬🇧 English\n🇩🇪 Deutsch\n🇪🇸 Español\n🇮🇹 Italiano\n🇵🇹 Português\n🇳🇱 Nederlands\n\nPara cambiar el idioma:\n1. Ve a Otros > Ajustes\n2. Selecciona tu bandera de idioma\n\nEl idioma se aplica instantáneamente en toda la app.";

/* Guía - Material */
"guide_equipment_title" = "Gestionar tu material";
"guide_equipment_content" = "La pestaña Material es tu inventario central:\n\n➕ Añadir equipo:\n• Nombre y descripción detallada\n• Categoría (crea las tuyas)\n• Valor estimado en €\n• Fecha de adquisición\n• Lugar de almacenamiento (opcional)\n• Ubicación precisa (ej: estante superior)\n• Foto del artículo\n• Foto del recibo con número y vendedor\n\n🔍 Filtrar inventario:\n• Por categoría (Herramientas, Deportes, Cocina...)\n• Por lugar de almacenamiento\n• Por estado (Disponible, Prestado, Alquilado)\n• Por búsqueda de texto\n\n📊 Ver detalles:\n• Historial de préstamos\n• Historial de alquileres\n• Historial de reparaciones";

/* Guía - Fotos */
"guide_photos_title" = "Fotos y recibos";
"guide_photos_content" = "Las fotos enriquecen tus fichas:\n\n📷 Foto del equipo:\n• Identifica visualmente el artículo\n• Visible en listas y exportaciones PDF\n• Toma directamente o elige de la galería\n\n🧾 Foto del recibo:\n• Prueba de compra importante\n• Número de recibo y vendedor (opcional)\n• Útil para seguro o garantía\n• Exportable a PDF\n\n💡 Consejo de calidad:\nEn Ajustes > Calidad de imagen, elige:\n• Original: Máxima calidad, archivos pesados\n• Alta: Buen compromiso\n• Media: Recomendada (ligera y suficiente)\n• Baja: Para ahorrar espacio";

/* Guía - Préstamos */
"guide_loans_title" = "Crear y gestionar préstamos";
"guide_loans_content" = "Un préstamo = equipo que confías a alguien.\n\n➕ Crear un préstamo:\n1. Selecciona el equipo a prestar\n2. Elige el prestatario (o crea uno)\n3. Establece fechas (inicio y fin esperado)\n4. Añade notas si es necesario\n\n📋 Estados del préstamo:\n🟢 En curso: Préstamo activo, sin retraso\n🟡 Pronto: Vence en menos de 3 días\n🔴 Atrasado: Fecha de fin pasada\n✅ Devuelto: Equipo devuelto\n\n✔️ Confirmar una devolución:\nToca 'Confirmar devolución' en la ficha del préstamo. Se registra la fecha real de devolución.\n\n📧 Seguimiento con un prestatario:\nDesde la ficha de la persona, envía un email resumen de los artículos en curso.";

/* Guía - Préstamos recibidos */
"guide_borrows_title" = "Seguir tus préstamos recibidos";
"guide_borrows_content" = "Un préstamo recibido = algo que alguien te presta.\n\n➕ Crear un préstamo recibido:\n1. Nombra el artículo prestado\n2. Selecciona el prestador (persona que te presta)\n3. Establece fechas de inicio y devolución esperada\n4. Toma una foto del artículo\n5. Añade notas (estado, condiciones...)\n\n🔄 Acciones sobre un préstamo recibido:\n• Prestarlo a otra persona\n• Alquilarlo (subalquiler)\n• Enviarlo a reparar\n• Devolverlo al prestador\n\n📦 Crear en Material:\nActiva esta opción para añadir el artículo prestado a tu inventario. Se eliminará automáticamente cuando lo devuelvas.\n\n⚠️ Bloqueo:\nNo puedes devolver un préstamo recibido si está actualmente prestado, alquilado o en reparación.";

/* Guía - Prestar lo prestado */
"guide_lend_borrow_title" = "Prestar un artículo prestado";
"guide_lend_borrow_content" = "¿Quieres prestar temporalmente algo que te prestaron?\n\n📤 Cómo hacerlo:\n1. Ve a la ficha del préstamo recibido\n2. Toca 'Prestar'\n3. Selecciona la persona a quien prestas\n4. Establece la fecha de devolución esperada\n\n⚠️ Reglas de bloqueo:\n• El préstamo recibido no puede devolverse mientras el préstamo esté activo\n• Primero debes recuperar el artículo del préstamo\n• Luego puedes devolver el préstamo recibido\n\n🔄 Misma lógica para:\n• Alquilar un préstamo recibido (subalquiler)\n• Enviar un préstamo recibido a reparar\n\nEsto permite un seguimiento completo de la cadena de posesión.";

/* Guía - Reparaciones */
"guide_repairs_title" = "Gestionar reparaciones";
"guide_repairs_content" = "Envía tu equipo a reparar y rastrea los costes.\n\n🔧 Crear una reparación:\n1. Selecciona el equipo a reparar\n2. Elige un reparador (tipo 'Reparador' requerido)\n3. Describe el problema\n4. Introduce el coste estimado\n5. Establece la fecha de devolución esperada\n\n📊 Seguimiento:\n• Estado: En curso / Completada\n• Coste estimado vs final\n• Indicador de retraso si vencido\n\n✅ Completar una reparación:\n1. Confirma la devolución\n2. Introduce el coste final\n3. Marca como 'Pagado' cuando esté liquidado\n\n💰 Contabilidad:\nLas reparaciones se registran automáticamente como gastos.";

/* Guía - Devoluciones */
"guide_return_title" = "Confirmar devoluciones";
"guide_return_content" = "Cuando un artículo es devuelto, confirma la devolución:\n\n✅ Para un préstamo:\nToca 'Confirmar devolución'. El equipo vuelve a estar disponible.\n\n✅ Para un préstamo recibido:\nToca 'Confirmar devolución'. El préstamo recibido se marca como devuelto.\n\n✅ Para un alquiler:\nToca 'Finalizar alquiler'. Luego deberás:\n• Marcar el pago como recibido\n• Gestionar la fianza (devolver o retener)\n\n✅ Para una reparación:\nToca 'Confirmar devolución de reparación'. Introduce el coste final.\n\n💡 Consejo:\nLas devoluciones tienen marca de tiempo. Encontrarás el historial completo en cada ficha.";

/* Guía - Alquileres */
"guide_rentals_title" = "Alquilar tu equipo";
"guide_rentals_content" = "Los alquileres te permiten alquilar tu equipo a cambio de pago.\n\n➕ Crear un alquiler:\n1. Selecciona el equipo a alquilar\n2. Elige el arrendatario\n3. Establece el tipo de tarifa:\n   • Día (precio × número de días)\n   • Semana (precio × número de semanas)\n   • Mes (precio × número de meses)\n   • Precio fijo\n4. Introduce el importe de la fianza\n5. Establece las fechas\n\n📊 Panel:\n• Ingresos recibidos (pagos confirmados)\n• Pendientes (aún no pagados)\n\n✅ Finalizar un alquiler:\n1. Finaliza el alquiler cuando el artículo sea devuelto\n2. Confirma la recepción del pago\n3. Gestiona la fianza (devolver o retener)";

/* Guía - Fianzas */
"guide_caution_title" = "Gestionar fianzas";
"guide_caution_content" = "La fianza es una garantía cobrada al final del alquiler.\n\n💵 Tipos de acciones:\n\n🔙 Devolver fianza:\nSi todo está OK, devuelve la fianza al arrendatario. No cuenta como ingreso.\n\n⚠️ Retener fianza:\nEn caso de daño o disputa, retén total o parcialmente. El importe retenido se añade a tus ingresos.\n\n📋 Seguimiento en 'Otros':\nLa sección 'Fianzas a devolver' lista todos los alquileres completados con gestión de fianza pendiente.\n\n💰 Contabilidad:\nSolo las fianzas retenidas aparecen en contabilidad como ingresos excepcionales.";

/* Guía - Subalquiler */
"guide_sublet_title" = "Subalquilar equipo";
"guide_sublet_content" = "Puedes subalquilar equipo que tú mismo estás alquilando.\n\n📤 Cómo hacerlo:\n1. Ve a tu ficha de alquiler activo\n2. Toca 'Subalquilar'\n3. Selecciona el subarrendatario\n4. Establece tus propias tarifas y condiciones\n\n⚠️ Reglas:\n• El alquiler principal no puede finalizarse mientras el subalquiler esté activo\n• Primero recupera el equipo del subalquiler\n• Luego finaliza el alquiler principal\n\n💰 Ingresos:\nLos ingresos del subalquiler se añaden a tu contabilidad normal.";

/* Guía - Yo alquilo */
"guide_myrentals_title" = "Yo alquilo - Equipo que alquilo";
"guide_myrentals_content" = "La sección 'Yo alquilo' permite gestionar el equipo que TÚ alquilas de otra persona (alquiler de equipo externo).\n\n📤 Crear un alquiler:\n1. Toca 'Añadir un alquiler'\n2. Nombra el equipo alquilado\n3. Selecciona el arrendador (a quién alquilas)\n4. Define el tipo de tarifa (día/semana/mes/forfait)\n5. Introduce el precio y la fianza pagada\n6. Define fechas de inicio y fin\n\n📊 Seguimiento:\n• Importe total del alquiler\n• Fianza pagada y recuperada\n• Estado: En curso, Retrasado, Terminado\n• Pago realizado o pendiente\n\n✅ Finalizar un alquiler:\n1. Marca el alquiler como terminado\n2. Introduce el importe de fianza recuperado\n3. Confirma el pago realizado\n\n⚠️ Recordatorios:\nLos alquileres con fianza no recuperada aparecen como alertas.";

/* Guía - Mis fianzas */
"guide_myrentals_caution_title" = "Gestionar mis fianzas pagadas";
"guide_myrentals_caution_content" = "Cuando alquilas equipo, a menudo pagas una fianza.\n\n💵 Seguimiento de fianza:\n• Importe de fianza pagado al firmar\n• Importe recuperado al final del alquiler\n• Diferencia en caso de retención\n\n🔄 Flujo de trabajo:\n1. Al crear, introduce la fianza pagada\n2. Al final del alquiler, introduce el importe recuperado\n3. La diferencia se calcula automáticamente\n\n📋 Alertas:\nEn 'Otros > Yo alquilo', una alerta te avisa si alquileres terminados tienen fianzas no recuperadas.\n\n💰 Contabilidad:\n• Fianza pagada = gasto temporal\n• Fianza recuperada = reembolso\n• Fianza no recuperada = pérdida (gasto definitivo)";

/* Guía - Comercio */
"guide_commerce_title" = "Módulo Compra/Venta";
"guide_commerce_content" = "El módulo de Comercio es ideal para mercados, tiendas y pequeños negocios.\n\n📦 Funciones:\n• Catálogo de productos con precios de compra y venta\n• Gestión automática de stock\n• Cálculo de IVA (repercutido, deducible, a pagar)\n• Descuentos porcentuales o fijos\n• Métodos de pago (efectivo, tarjeta, cheque, transferencia)\n• Pagos aplazados con recordatorios\n\n📊 Contabilidad comercial:\n• Total ventas / compras / beneficios\n• Detalle de IVA por tipo\n• Ticket medio\n• Desglose por método de pago\n• Alertas de stock bajo\n\n🔄 Exportar/importar JSON para hacer backup de tus datos.";

/* Guía - Artículos */
"guide_articles_title" = "Gestionar tus productos";
"guide_articles_content" = "Los productos son artículos de tu catálogo comercial.\n\n➕ Crear un producto:\n• Nombre y descripción\n• Categoría (crea las tuyas)\n• Referencia / SKU\n• Precio de compra sin IVA y tipo de IVA de compra\n• Precio de venta con IVA y tipo de IVA de venta\n• Stock actual y umbral de alerta\n• Proveedor (opcional)\n• Foto (opcional)\n\n📊 Margen automático:\nLa app calcula automáticamente tu margen y porcentaje.\n\n🔔 Alertas de stock:\nCuando el stock baja del umbral, el artículo aparece en alertas.\n\n⚡ Venta rápida:\nMantén pulsado un producto para venta rápida sin entrada compleja.";

/* Guía - Transacciones */
"guide_transactions_title" = "Registrar transacciones";
"guide_transactions_content" = "Las transacciones son tus ventas y compras.\n\n🛒 Crear una transacción:\n1. Elige tipo: Venta o Compra\n2. Selecciona un artículo del catálogo O introduce libremente\n3. Introduce cantidad\n4. Aplica descuento (opcional): % o importe fijo\n5. Elige método de pago: Efectivo, Tarjeta, Cheque, Transferencia\n6. Indica si está pagado o pendiente\n7. Si está pendiente, establece fecha de pago\n\n📊 Resumen automático:\n• Importe bruto sin IVA\n• Descuento aplicado\n• Importe neto sin IVA\n• IVA calculado\n• Total con IVA\n\n🔔 Recordatorios:\nActiva notificaciones para pagos próximos (3 días antes).";

/* Guía - Contabilidad */
"guide_accounting_title" = "Contabilidad de alquileres";
"guide_accounting_content" = "La contabilidad agrupa automáticamente tus operaciones financieras.\n\n📊 Contenido:\n• Ingresos: Alquileres pagados\n• Ingresos: Fianzas retenidas\n• Gastos: Reparaciones pagadas\n\n📅 Períodos:\n• Vista por mes\n• Vista por año\n• Vista total\n\n💰 Indicadores:\n• Total ingresos (verde)\n• Total gastos (rojo)\n• Beneficio neto\n\n📤 Exportar:\n• PDF formateado para contabilidad\n• JSON para backup/importación\n\nLas operaciones se añaden automáticamente cuando marcas un pago como recibido.";

/* Guía - Contabilidad comercial */
"guide_commerce_accounting_title" = "Contabilidad comercial";
"guide_commerce_accounting_content" = "Vista completa de tu actividad de ventas.\n\n📊 Panel:\n• Total ventas con IVA\n• Total compras con IVA\n• Beneficio neto\n• Ticket medio (ventas y compras)\n\n💹 IVA detallado:\n• IVA repercutido (en ventas)\n• IVA deducible (en compras)\n• IVA a pagar (diferencia)\n• Detalle por tipo (5,5%, 10%, 21%...)\n\n💳 Desglose de pagos:\n• Efectivo / Tarjeta / Cheque / Transferencia\n• Visualización porcentual\n\n📦 Stock:\n• Número de artículos en stock\n• Artículos en alerta (stock bajo)\n\n💸 Descuentos concedidos:\n• Total descuentos en ventas\n• Total descuentos en compras";

/* Guía - Personas */
"guide_people_title" = "Lista de contactos";
"guide_people_content" = "Gestiona las personas con las que interactúas.\n\n➕ Añadir una persona:\n• Nombre y apellido\n• Email (permite enviar emails)\n• Teléfono (permite llamadas directas)\n• Organización (empresa, asociación...)\n• Tipo: Persona, Reparador o Empleado\n• Foto (opcional)\n\n📧 Email de recordatorio:\nDesde la ficha de una persona, envía un email listando automáticamente:\n• Equipo actualmente prestado\n• Fechas de devolución esperadas\n• Indicaciones de retraso\n\n📞 Llamada directa:\nToca el número de teléfono para llamar directamente.\n\n📇 Importar Contactos:\nImporta automáticamente desde los contactos de tu iPhone.";

/* Guía - Tipos de personas */
"guide_people_types_title" = "Tipos de personas";
"guide_people_types_content" = "Tres tipos para organizar tus contactos:\n\n👤 Persona (por defecto):\nClientes, amigos, familia... Cualquiera a quien prestes o alquiles equipo.\n\n🔧 Reparador:\nArtesanos y talleres de reparación. Solo los reparadores pueden seleccionarse al enviar a reparar.\n\n👷 Empleado:\nMiembros del equipo. Pueden asignarse a obras. Ideal para empresas con varios sitios.\n\n💡 Consejo:\nUna persona solo puede tener un tipo. Cámbialo en cualquier momento desde su ficha.";

/* Guía - Duplicados */
"guide_duplicates_title" = "Fusionar duplicados";
"guide_duplicates_content" = "La app detecta automáticamente personas duplicadas.\n\n🔍 Cómo funciona:\n• Detección por nombre + apellido idénticos\n• Ignora mayúsculas/minúsculas y espacios\n\n🔄 Fusionar:\n1. Ve a Otros > Personas\n2. Toca el botón 'Duplicados' en la barra de herramientas\n3. Selecciona el grupo de duplicados\n4. Elige la persona a conservar\n5. Confirma la fusión\n\n✅ Resultado:\n• Todos los préstamos se reasignan\n• Todos los préstamos recibidos se reasignan\n• Todos los alquileres se reasignan\n• Los duplicados se eliminan\n\n💡 Revisa los datos de contacto de la persona conservada.";

/* Guía - Obras */
"guide_worksites_title" = "Gestión de obras";
"guide_worksites_content" = "Organiza tu equipo en múltiples sitios de trabajo.\n\n🏗️ Crear una obra:\n• Nombre de la obra\n• Dirección completa\n• Descripción y notas\n• Fechas de inicio y fin\n• Contacto principal del sitio\n• Estado: Activa o Completada\n\n👷 Asignar empleados:\n1. Crea personas tipo 'Empleado'\n2. Abre la ficha de la obra\n3. Añade los empleados relevantes\n\n🗺️ Navegación:\nToca la dirección para abrir en Mapas.\n\n📊 Estados automáticos:\n• Preparando: Fecha de inicio no alcanzada\n• Activa: En curso\n• Completada: Marcada como terminada\n\n📤 Exportar a PDF o JSON.";

/* Guía - Lugares */
"guide_locations_title" = "Lugares de almacenamiento";
"guide_locations_content" = "Organiza dónde se almacena tu equipo.\n\n📍 Crear un lugar:\n• Nombre (ej: Garaje, Almacén Norte...)\n• Dirección completa\n• Edificio\n• Planta\n• Sala\n• Notas\n\n📦 Uso:\n• Asocia cada equipo con un lugar\n• Añade ubicación precisa (ej: estante B, cajón 3)\n• Filtra tu inventario por lugar\n\n🔍 Encontrar un artículo:\n1. Búscalo en Material\n2. La ficha muestra lugar y ubicación exacta\n\n📊 Resumen:\nLa ficha de un lugar muestra todo el equipo almacenado allí.";

/* Guía - Categorías */
"guide_categories_title" = "Gestionar categorías";
"guide_categories_content" = "Las categorías organizan tu inventario.\n\n➕ Crear una categoría:\nAl añadir equipo, escribe un nuevo nombre de categoría.\n\n🗂️ Categorías sugeridas:\n• Herramientas\n• Electrónica\n• Deportes\n• Cocina\n• Jardinería\n• Bricolaje\n• Música\n• Foto/Vídeo\n\n📝 Gestionar categorías:\n1. En la lista de Material\n2. Toca el icono de carpeta junto al filtro de categoría\n3. Renombra o elimina\n\n⚠️ Eliminar una categoría:\nEl equipo no se elimina, solo pierde su categoría.";

/* Guía - Búsqueda */
"guide_search_title" = "Búsqueda y filtros";
"guide_search_content" = "Encuentra rápidamente cualquier artículo.\n\n🔍 Barra de búsqueda:\n• Disponible en cada lista\n• Busca en nombre y descripción\n• Resultados en tiempo real\n\n🎯 Filtros combinables:\n\n📦 Material:\n• Por categoría\n• Por lugar de almacenamiento\n• Por estado (Disponible, Prestado, Alquilado)\n\n↗️ Préstamos / ↙️ Prestados:\n• Todos / En curso / Atrasados / Devueltos / Pronto\n\n🏷️ Alquileres:\n• Por estado\n• Por estado de pago\n• Por estado de fianza\n\n🔧 Reparaciones:\n• En curso / Completadas\n• Pagadas / No pagadas\n\n💡 Botón restablecer:\nRestablece todos los filtros con un toque.";

/* Guía - Estados */
"guide_status_title" = "Entender los estados";
"guide_status_content" = "Códigos de color en toda la app:\n\n🟢 Verde:\n• Disponible\n• Devuelto\n• Pagado\n• Completado\n\n🟡 Naranja:\n• En curso\n• Pronto (< 3 días)\n• Esperando pago\n\n🔴 Rojo:\n• Atrasado\n• No pagado (fecha pasada)\n• Problema detectado\n\n🔵 Azul:\n• Información\n• Enlace clicable\n• Acción disponible\n\n📊 Indicadores visuales:\n• Icono de reloj: En curso\n• Icono de triángulo: Atrasado\n• Icono de check: Completado/Devuelto\n• Badge numérico: Cantidad de artículos";

/* Guía - Caja fuerte */
"guide_safe_title" = "Caja fuerte segura";
"guide_safe_content" = "Protege tus documentos importantes con acceso seguro.\n\n🔐 Configuración:\n1. Crea una contraseña (mín. 4 caracteres)\n2. Elige una pregunta de recuperación\n3. Responde la pregunta secreta\n\n📦 Contenido recomendado:\n• Joyas y relojes valiosos\n• Electrónica cara\n• Obras de arte\n• Documentos importantes\n• Recibos de compras importantes\n\n🏷️ Para cada artículo:\n• Foto del artículo\n• Nombre y descripción\n• Valor estimado\n• Marca, modelo, número de serie\n• Foto de recibo/comprobante de compra\n\n📄 Inventario para seguro:\nExporta un PDF completo para tu aseguradora.";

/* Guía - Biometría */
"guide_biometric_title" = "Face ID / Touch ID";
"guide_biometric_content" = "Accede a la caja fuerte con biometría.\n\n✅ Ventajas:\n• Acceso rápido sin introducir contraseña\n• Seguridad mejorada\n• Mismo nivel de protección que tu iPhone\n\n🔧 Activación:\nLa autenticación biométrica es automática si tu dispositivo la soporta.\n\n📱 Compatibilidad:\n• Face ID (iPhone X y posteriores)\n• Touch ID (iPhone con sensor)\n\n🔑 Respaldo:\nSi la biometría falla, introduce tu contraseña.\n\n⚠️ Contraseña olvidada:\n1. Usa la pregunta de recuperación\n2. Último recurso: reset completo (pérdida de datos)";

/* Guía - Contraseña */
"guide_password_title" = "Gestión de contraseña";
"guide_password_content" = "Asegura tu caja fuerte con una contraseña fuerte.\n\n🔑 Reglas:\n• Mínimo 4 caracteres\n• Confirmación requerida\n• Pregunta de recuperación recomendada\n\n🔄 Cambiar contraseña:\n1. Abre la caja fuerte\n2. Menú > Cambiar contraseña\n3. Introduce contraseña antigua\n4. Introduce y confirma la nueva\n\n❓ Contraseña olvidada:\n1. Toca '¿Olvidaste tu contraseña?'\n2. Responde la pregunta secreta\n3. Crea una nueva contraseña\n\n⚠️ Todo olvidado:\nSi olvidaste contraseña Y respuesta, la única opción es reset completo. Se perderán todos los datos.";

/* Guía - Facturas */
"guide_invoices_title" = "Gestión de recibos";
"guide_invoices_content" = "Guarda tus comprobantes de compra digitalmente.\n\n🧾 Para cada equipo:\n• Foto del recibo (JPG o PDF)\n• Número de recibo\n• Nombre del vendedor/tienda\n• Fecha de adquisición (automática o manual)\n\n🏠 Para la caja fuerte:\n• Foto de recibo/comprobante de compra\n• Misma información\n\n💡 Usos:\n• Prueba de propiedad para seguro\n• Seguimiento de garantía\n• Evidencia en caso de disputa\n• Exportación en fichas PDF\n\n📤 Exportar:\nLos recibos se incluyen en:\n• Fichas PDF de equipos\n• PDF de inventario para seguro\n• Backup JSON";

/* Guía - Backup */
"guide_backup_title" = "Backup y restauración";
"guide_backup_content" = "Protege tus datos con backups regulares.\n\n💾 Backup local:\nToca 'Guardar ahora' en Ajustes. Crea un punto de restauración local.\n\n📤 Exportar JSON:\nExporta todos tus datos (o selección) en formato JSON:\n• Enviar por email\n• Guardar en Archivos\n• Compartir por AirDrop\n\n📥 Importar JSON:\nRestaura tus datos desde un archivo JSON previamente exportado.\n\n✅ Datos exportados:\n• Equipos + fotos\n• Préstamos y préstamos recibidos\n• Alquileres y reparaciones\n• Personas\n• Lugares y obras\n• Comercio (productos + transacciones)\n• Caja fuerte";

/* Guía - PDF */
"guide_pdf_title" = "Exportación PDF";
"guide_pdf_content" = "Crea documentos PDF profesionales.\n\n📄 Tipos de exportación:\n\n📦 Catálogo de equipos:\n• Ficha detallada por artículo\n• Foto + descripción\n• Valor y lugar de almacenamiento\n• Foto del recibo\n\n🔐 Inventario para seguro:\n• Lista completa de la caja fuerte\n• Fotos y comprobantes de compra\n• Valor total estimado\n• Para enviar a tu aseguradora\n\n📊 Contabilidad:\n• Resumen de operaciones\n• Ingresos y gastos\n• Por período (mes/año)\n\n💡 Opciones:\n• Excluir artículos devueltos\n• Elegir calidad de imagen\n• Seleccionar tipos de datos";

/* Guía - JSON */
"guide_json_title" = "Exportar/Importar JSON";
"guide_json_content" = "El formato JSON es ideal para backups completos.\n\n✅ Ventajas:\n• Datos estructurados\n• Incluye todas las fotos\n• Restauración completa posible\n• Transferencia entre dispositivos\n\n📤 Exportar:\n1. Ajustes > Exportar\n2. Selecciona datos\n3. Comparte el archivo .json\n\n📥 Importar:\n1. Ajustes > Importar JSON\n2. Selecciona archivo\n3. Los datos se fusionan (sin duplicados)\n\n💡 Consejo:\nHaz una exportación JSON mensual y guárdala en iCloud, Google Drive o por email.\n\n⚠️ Importar:\nLos elementos existentes (mismo ID) no se duplican.";

/* Guía - Calidad de imagen */
"guide_image_quality_title" = "Calidad de imagen";
"guide_image_quality_content" = "Optimiza el tamaño de tus exportaciones.\n\n📷 Opciones disponibles:\n\n🟣 Original (iPhone):\n• Máxima calidad\n• Archivos muy grandes (~5 MB)\n• Para archivado de alta calidad\n\n🔵 Alta (2000px):\n• Excelente calidad\n• Tamaño reducido (~2 MB)\n• Buen compromiso\n\n🟢 Media (1200px):\n• Buena calidad\n• Archivos ligeros (~800 KB)\n• Recomendada ✅\n\n🟠 Baja (800px):\n• Calidad aceptable\n• Muy ligero (~300 KB)\n• Para exportaciones numerosas\n\n⚙️ Cambiar:\nAjustes > Calidad de imagen";

/* Guía - Consejos */
"guide_tips_title" = "Consejos prácticos";
"guide_tips_content" = "Saca el máximo partido a la app:\n\n📸 Fotos:\n• Fotografía cada artículo valioso\n• Incluye números de serie\n• Guarda fotos de recibos\n\n👥 Contactos:\n• Crea personas antes de los préstamos\n• Introduce emails y teléfonos\n• Usa la importación de Contactos\n\n📅 Fechas:\n• Sé realista con las fechas de devolución\n• Revisa regularmente los retrasos\n• Envía emails de recordatorio\n\n💾 Backups:\n• Exporta JSON mensualmente\n• Guarda en la nube\n• Prueba una restauración\n\n🔐 Caja fuerte:\n• Inventaría tus objetos de valor\n• Guarda comprobantes de compra\n• Exporta para el seguro";

/* Guía - Mejores prácticas */
"guide_best_practices_title" = "Mejores prácticas";
"guide_best_practices_content" = "Optimiza tu uso diario:\n\n✅ Haz:\n• Toma una foto ANTES de prestar\n• Anota el estado en las notas\n• Confirma las devoluciones rápidamente\n• Mantén las categorías consistentes\n• Haz backups regulares\n\n❌ Evita:\n• Olvidar confirmar devoluciones\n• Ignorar préstamos atrasados\n• Mezclar personas y reparadores\n• Descuidar fotos de recibos\n\n💡 Flujo de trabajo ideal:\n1. Crea tus lugares de almacenamiento\n2. Añade contactos clave\n3. Inventaría tu equipo\n4. Fotografía recibos\n5. Usa la creación rápida a diario";

/* Guía - Email */
"guide_email_title" = "Enviar emails";
"guide_email_content" = "Comunícate fácilmente con tus contactos.\n\n📧 Email de recordatorio:\n1. Abre la ficha de la persona\n2. Toca el icono de email\n3. Se abre un mensaje pre-rellenado con:\n   • Lista de equipos prestados\n   • Fechas de devolución esperadas\n   • Indicaciones de retraso\n\n📧 Recordatorio de pago:\nPara alquileres no pagados, envía un recordatorio listando importes pendientes.\n\n✅ Requisitos:\n• El email debe estar introducido en la ficha\n• La app de Mail debe estar configurada\n\n💡 Personalizar:\nEl mensaje se abre en Mail, puedes editarlo antes de enviar.";

/* Guía - Alertas */
"guide_alerts_title" = "Alertas y notificaciones";
"guide_alerts_content" = "La app te avisa visualmente:\n\n🔴 Indicadores de retraso:\n• Badge rojo en préstamos atrasados\n• Triángulo de aviso en préstamos recibidos\n• Color rojo en listas\n\n🟡 Plazos próximos:\n• Filtro 'Pronto' (< 3 días)\n• Color naranja\n\n💰 Pagos:\n• Sección 'Pagos próximos'\n• Sección 'Pagos atrasados'\n• Alertas de comercio para vencimientos\n\n📦 Stock bajo:\n• Badge en artículos en alerta\n• Visible en Comercio\n\n💡 Consejo:\nRevisa regularmente los filtros 'Atrasado' y 'Pronto' para anticiparte.";

/* Guía - Capacidad */
"guide_capacity_title" = "Capacidad y límites";
"guide_capacity_content" = "Versión gratuita vs Premium:\n\n🆓 Versión gratuita:\n• 10 equipos\n• 5 préstamos activos\n• 5 préstamos recibidos activos\n• 5 alquileres\n• 5 reparaciones\n• 10 personas\n• 3 lugares\n• 5 objetos en caja fuerte\n\n👑 Versión Premium:\n• ¡Todo ILIMITADO!\n• Pago único, acceso de por vida\n• Apoya el desarrollo\n\n💾 Almacenamiento:\n• Datos locales en tu iPhone\n• Sin límite técnico\n• Las fotos ocupan más espacio\n\n💡 Consejo:\nHaz backups regulares, especialmente con muchos datos.";

/* Guía - Premium */
"guide_premium_title" = "Hazte Premium";
"guide_premium_content" = "Desbloquea todo el potencial de la app.\n\n👑 Ventajas Premium:\n• Equipos ilimitados\n• Préstamos ilimitados\n• Préstamos recibidos ilimitados\n• Alquileres ilimitados\n• Reparaciones ilimitadas\n• Personas ilimitadas\n• Lugares ilimitados\n• Caja fuerte ilimitada\n\n💳 Pago:\n• Pago único\n• Acceso de por vida\n• Sin suscripción\n\n🔄 Restaurar:\nSi cambias de dispositivo:\n1. Ve a Premium\n2. Toca 'Restaurar compras'\n3. Tus compras se restauran\n\n❤️ Apoyo:\n¡Tu compra ayuda a mejorar la app!";

/* Guía - FAQ */
"guide_faq_title" = "Preguntas frecuentes";
"guide_faq_content" = "❓ ¿Mis datos están seguros?\nSí, todo se almacena localmente en tu iPhone. La caja fuerte está protegida por contraseña.\n\n❓ ¿Puedo usar la app en iPad/Mac?\nSí, la app es universal y funciona en iPhone, iPad y Mac (Apple Silicon).\n\n❓ ¿Cómo transfiero mis datos?\nExporta a JSON, luego importa en el nuevo dispositivo.\n\n❓ ¿La app funciona sin conexión?\nSí, todas las funciones están disponibles sin internet.\n\n❓ ¿Cómo contacto con soporte?\nEnvía un email desde la página de la App Store o desde Ajustes.\n\n❓ ¿Las actualizaciones son gratuitas?\nSí, todas las actualizaciones están incluidas.";

