"guide_lend_borrow_title" = "Emprestar um objeto emprestado";
"guide_lend_borrow_content" = "Você pegou um objeto emprestado e quer emprestá-lo temporariamente? Use o botão 'Emprestar' em cada empréstimo recebido ativo. O empréstimo recebido será bloqueado para devolução enquanto o empréstimo não for recuperado. Você também pode marcar 'Criar em Materiais' ao criar um empréstimo recebido para adicioná-lo ao seu inventário - será automaticamente removido na devolução.";

/* Guia - Aluguéis pagos */
"guide_rentals_title" = "Alugar seu material";
"guide_rentals_content" = "A aba 'Aluguéis' permite alugar seu material por dinheiro. Defina uma tarifa (dia/semana/mês/fixo), uma caução e acompanhe os pagamentos. O resumo financeiro mostra sua receita recebida e pendente. Finalize o aluguel quando o item for devolvido, depois gerencie a devolução da caução.";

/* Guia - Alugar um empréstimo recebido */
"guide_sublet_title" = "Alugar um objeto emprestado";
"guide_sublet_content" = "Você pegou um objeto emprestado e quer alugá-lo temporariamente? Use o botão 'Alugar' em cada empréstimo recebido ativo. O empréstimo recebido será bloqueado para devolução enquanto o aluguel não for recuperado. Defina suas próprias tarifas e condições. Primeiro recupere o material do aluguel antes de poder devolver seu empréstimo.";

/* Guia - Gestão de duplicados */
"guide_duplicates_title" = "Mesclar duplicados";
"guide_duplicates_content" = "O aplicativo detecta automaticamente pessoas duplicadas (mesmo nome/sobrenome). Vá em 'Outro > Pessoas' e pressione o botão 'Duplicados' na barra de ferramentas. Selecione o grupo a mesclar: todos os empréstimos serão reatribuídos à pessoa mantida, as outras serão excluídas.";

