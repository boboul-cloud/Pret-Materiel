/* Anleitung - KI-Scanner */
"guide_scanner_intro_title" = "Intelligenter Scanner";
"guide_scanner_intro_content" = "Der KI-Scanner verwendet OpenAI Vision-Technologie (GPT-4o), um Ihre Geräte automatisch anhand eines Fotos zu identifizieren. Er erkennt den Objekttyp, die Marke, das Modell und schlägt eine passende Kategorie vor.";
"guide_scanner_apikey_title" = "OpenAI API-Schlüssel erforderlich";
"guide_scanner_apikey_content" = "Um diese Funktion zu nutzen, benötigen Sie einen OpenAI API-Schlüssel:\n\n1. Erstellen Sie ein Konto auf platform.openai.com\n2. Gehen Sie zu API Keys und erstellen Sie einen neuen Schlüssel\n3. Kopieren Sie den Schlüssel (beginnt mit 'sk-')\n4. Fügen Sie ihn in der App bei der ersten Verwendung des Scanners ein\n\nIhr Schlüssel wird nur auf Ihrem Gerät gespeichert und niemals geteilt.";
"guide_scanner_cost_title" = "Nutzungskosten";
"guide_scanner_cost_content" = "Die Nutzung der OpenAI API ist kostenpflichtig:\n\n• Ca. 0,003 bis 0,01 € pro analysiertem Foto\n• Die Kosten werden direkt über Ihr OpenAI-Konto abgerechnet\n• Sie können Ausgabenlimits auf platform.openai.com festlegen\n• Überprüfen Sie regelmäßig Ihre Nutzung im OpenAI-Dashboard\n\nDie App hat keinen Zugriff auf Ihre Zahlungsinformationen.";
"guide_scanner_howto_title" = "So funktioniert es";
"guide_scanner_howto_content" = "1. Tippen Sie auf 'Mit KI scannen' in der Geräteliste\n2. Machen Sie ein Foto oder wählen Sie ein vorhandenes Bild\n3. Tippen Sie auf 'Mit KI identifizieren'\n4. Das Bild wird zur Analyse an OpenAI gesendet\n5. Felder werden automatisch vorausgefüllt\n6. Überprüfen und ändern Sie bei Bedarf\n7. Erstellen Sie das Gerät";
"guide_scanner_tips_title" = "Tipps für bessere Ergebnisse";
"guide_scanner_tips_content" = "• Fotografieren Sie bei guter Beleuchtung\n• Rahmen Sie das gesamte Objekt im Bild ein\n• Wenn möglich, zeigen Sie das Etikett oder Markenlogo\n• Vermeiden Sie unscharfe oder zu dunkle Fotos\n• Ein neutraler Hintergrund verbessert die Erkennung";
"guide_scanner_internet_title" = "Internetverbindung erforderlich";
"guide_scanner_internet_content" = "Der KI-Scanner benötigt eine Internetverbindung. Das Bild wird zur Analyse an OpenAI-Server gesendet. Ohne Verbindung können Sie Ihre Geräte weiterhin manuell hinzufügen.";
"guide_scanner_privacy_title" = "Datenschutz";
"guide_scanner_privacy_content" = "• Ihr API-Schlüssel wird lokal auf Ihrem Gerät gespeichert\n• Bilder werden direkt an OpenAI gesendet (kein Zwischenserver)\n• Siehe OpenAI-Datenschutzrichtlinie für weitere Informationen\n• Sie können Ihren Schlüssel jederzeit in den Scanner-Einstellungen löschen";

/* Anleitung - Einführung */
"guide_intro_title" = "Willkommen bei Material";
"guide_intro_content" = "Material ist Ihr vollständiger Assistent für alles, was Sie verleihen, leihen, vermieten oder verkaufen.\n\n📦 Inventar: Katalogisieren Sie Ihre Geräte mit Fotos und Belegen\n🔄 Ausleihen/Leihen: Verfolgen Sie, wer was hat und bis wann\n💰 Vermietung: Vermieten Sie Ihre Geräte und verwalten Sie Zahlungen\n🛒 Handel: Verwalten Sie Ihre Käufe und Verkäufe mit MwSt\n🔐 Tresor: Schützen Sie Ihre wichtigen Dokumente\n📊 Buchhaltung: Verfolgen Sie Ihre Einnahmen und Ausgaben\n\nNavigieren Sie zwischen den Tabs unten, um auf die verschiedenen Funktionen zuzugreifen.";

/* Anleitung - Startseite */
"guide_home_title" = "Startseite";
"guide_home_content" = "Die Startseite bietet schnellen Zugriff auf Hauptaktionen:\n\n📸 Schnelle Ausleihe: Fotografieren Sie einen Artikel, den Sie verleihen, fügen Sie Infos hinzu und fertig!\n\n📸 Schnelle Leihe: Jemand leiht Ihnen etwas? Notieren Sie es in Sekunden.\n\n👑 Premium werden: Die kostenlose Version hat begrenzte Artikel. Premium schaltet alles unbegrenzt frei.\n\nSchnellschaltflächen erstellen automatisch Geräte und Kontakte bei Bedarf.";

/* Anleitung - Schnellerstellung */
"guide_quick_create_title" = "Schnellerstellung mit Foto";
"guide_quick_create_content" = "Schnellerstellung ist der einfachste Einstieg:\n\n1️⃣ Tippen Sie auf 'Schnelle Ausleihe erstellen' oder 'Schnelle Leihe erstellen'\n2️⃣ Machen Sie ein Foto des Artikels (optional aber empfohlen)\n3️⃣ Geben Sie den Artikelnamen ein\n4️⃣ Fügen Sie den Personennamen hinzu\n5️⃣ Legen Sie das erwartete Rückgabedatum fest\n6️⃣ Bestätigen!\n\nDie App erstellt automatisch:\n• Die Gerätekarte mit Foto\n• Den Kontakt, falls neu\n• Die Ausleihe oder Leihe mit Daten\n\nSie können diese Elemente jederzeit bearbeiten.";

/* Anleitung - Navigation */
"guide_navigation_title" = "Navigation in der App";
"guide_navigation_content" = "Die App ist in 5 Haupttabs organisiert:\n\n🏠 Home: Schnellaktionen und Übersicht\n\n📦 Material: Ihr vollständiges Inventar mit Filtern nach Kategorie, Ort und Status\n\n↗️ Ausleihen: Was Sie an andere verleihen (filterbar nach Status: Laufend, Verspätet, Zurückgegeben)\n\n↙️ Geliehen: Was andere Ihnen leihen (gleiche Filter verfügbar)\n\n⚙️ Weitere: Personen, Orte, Baustellen, Vermietungen, Reparaturen, Handel, Buchhaltung, Tresor und Einstellungen\n\nJede Liste ist durchsuchbar und sortierbar.";

/* Anleitung - Sprache */
"guide_language_title" = "Sprache ändern";
"guide_language_content" = "Die App ist in 7 Sprachen verfügbar:\n🇫🇷 Français\n🇬🇧 English\n🇩🇪 Deutsch\n🇪🇸 Español\n🇮🇹 Italiano\n🇵🇹 Português\n🇳🇱 Nederlands\n\nSprache ändern:\n1. Gehen Sie zu Weitere > Einstellungen\n2. Wählen Sie Ihre Sprachflagge\n\nDie Sprache wird sofort in der gesamten App angewendet.";

/* Anleitung - Material */
"guide_equipment_title" = "Ihr Material verwalten";
"guide_equipment_content" = "Der Material-Tab ist Ihr zentrales Inventar:\n\n➕ Material hinzufügen:\n• Name und detaillierte Beschreibung\n• Kategorie (eigene erstellen)\n• Geschätzter Wert in €\n• Anschaffungsdatum\n• Lagerort (optional)\n• Präziser Standort (z.B. oberes Regal)\n• Foto des Artikels\n• Belegfoto mit Nummer und Verkäufer\n\n🔍 Inventar filtern:\n• Nach Kategorie (Werkzeuge, Sport, Küche...)\n• Nach Lagerort\n• Nach Status (Verfügbar, Verliehen, Vermietet)\n• Nach Textsuche\n\n📊 Details anzeigen:\n• Ausleihhistorie\n• Vermietungshistorie\n• Reparaturhistorie";

/* Anleitung - Fotos */
"guide_photos_title" = "Fotos und Belege";
"guide_photos_content" = "Fotos bereichern Ihre Karten:\n\n📷 Gerätefoto:\n• Visuell den Artikel identifizieren\n• Sichtbar in Listen und PDF-Exporten\n• Direkt aufnehmen oder aus Galerie wählen\n\n🧾 Belegfoto:\n• Wichtiger Kaufnachweis\n• Belegnummer und Verkäufer (optional)\n• Nützlich für Versicherung oder Garantie\n• Exportierbar in PDF\n\n💡 Qualitätstipp:\nIn Einstellungen > Bildqualität wählen:\n• Original: Max. Qualität, große Dateien\n• Hoch: Guter Kompromiss\n• Mittel: Empfohlen (leicht und ausreichend)\n• Niedrig: Zum Platzsparen";

/* Anleitung - Ausleihen */
"guide_loans_title" = "Ausleihen erstellen und verwalten";
"guide_loans_content" = "Eine Ausleihe = Gerät, das Sie jemandem anvertrauen.\n\n➕ Ausleihe erstellen:\n1. Wählen Sie das zu verleihende Gerät\n2. Wählen Sie den Entleiher (oder erstellen Sie einen)\n3. Legen Sie Daten fest (Start und erwartetes Ende)\n4. Fügen Sie bei Bedarf Notizen hinzu\n\n📋 Ausleihstatus:\n🟢 Laufend: Aktive Ausleihe, keine Verzögerung\n🟡 Bald: Fällig in weniger als 3 Tagen\n🔴 Verspätet: Enddatum überschritten\n✅ Zurückgegeben: Gerät zurückgegeben\n\n✔️ Rückgabe bestätigen:\nTippen Sie auf 'Rückgabe bestätigen' auf der Ausleihkarte. Das tatsächliche Rückgabedatum wird erfasst.\n\n📧 Entleiher nachhaken:\nVon der Personenkarte aus eine Zusammenfassungs-E-Mail der laufenden Artikel senden.";

/* Anleitung - Leihen */
"guide_borrows_title" = "Ihre Leihen verfolgen";
"guide_borrows_content" = "Eine Leihe = etwas, das jemand Ihnen leiht.\n\n➕ Leihe erstellen:\n1. Benennen Sie den geliehenen Artikel\n2. Wählen Sie den Verleiher (Person, die Ihnen leiht)\n3. Legen Sie Start- und erwartetes Rückgabedatum fest\n4. Machen Sie ein Foto des Artikels\n5. Fügen Sie Notizen hinzu (Zustand, Bedingungen...)\n\n🔄 Aktionen bei einer Leihe:\n• An jemand anderen verleihen\n• Weitervermieten (Untervermietung)\n• Zur Reparatur schicken\n• An den Verleiher zurückgeben\n\n📦 Im Material erstellen:\nAktivieren Sie diese Option, um den geliehenen Artikel zu Ihrem Inventar hinzuzufügen. Er wird automatisch entfernt, wenn Sie ihn zurückgeben.\n\n⚠️ Blockierung:\nSie können eine Leihe nicht zurückgeben, wenn sie derzeit verliehen, vermietet oder in Reparatur ist.";

/* Anleitung - Geliehenes weiterverleihen */
"guide_lend_borrow_title" = "Geliehenen Artikel weiterverleihen";
"guide_lend_borrow_content" = "Möchten Sie etwas Geliehenes vorübergehend weiterverleihen?\n\n📤 Vorgehensweise:\n1. Gehen Sie zur Leihkarte\n2. Tippen Sie auf 'Verleihen'\n3. Wählen Sie die Person, der Sie verleihen\n4. Legen Sie das erwartete Rückgabedatum fest\n\n⚠️ Blockierungsregeln:\n• Die Leihe kann nicht zurückgegeben werden, solange die Ausleihe aktiv ist\n• Sie müssen den Artikel zuerst von der Ausleihe zurückholen\n• Dann können Sie die Leihe zurückgeben\n\n🔄 Gleiche Logik für:\n• Vermieten einer Leihe (Untervermietung)\n• Leihe zur Reparatur schicken\n\nDies ermöglicht vollständige Verfolgung der Besitzkette.";

/* Anleitung - Reparaturen */
"guide_repairs_title" = "Reparaturen verwalten";
"guide_repairs_content" = "Schicken Sie Ihre Geräte zur Reparatur und verfolgen Sie die Kosten.\n\n🔧 Reparatur erstellen:\n1. Wählen Sie das zu reparierende Gerät\n2. Wählen Sie einen Reparateur (Typ 'Reparateur' erforderlich)\n3. Beschreiben Sie das Problem\n4. Geben Sie die geschätzten Kosten ein\n5. Legen Sie das erwartete Rückgabedatum fest\n\n📊 Verfolgung:\n• Status: In Bearbeitung / Abgeschlossen\n• Geschätzte vs. endgültige Kosten\n• Verspätungsanzeige bei Überfälligkeit\n\n✅ Reparatur abschließen:\n1. Bestätigen Sie die Rückgabe\n2. Geben Sie die endgültigen Kosten ein\n3. Markieren Sie als 'Bezahlt' wenn beglichen\n\n💰 Buchhaltung:\nReparaturen werden automatisch als Ausgaben erfasst.";

/* Anleitung - Rückgaben */
"guide_return_title" = "Rückgaben bestätigen";
"guide_return_content" = "Wenn ein Artikel zurückgegeben wird, bestätigen Sie die Rückgabe:\n\n✅ Für eine Ausleihe:\nTippen Sie auf 'Rückgabe bestätigen'. Das Gerät wird wieder verfügbar.\n\n✅ Für eine Leihe:\nTippen Sie auf 'Rückgabe bestätigen'. Die Leihe wird als zurückgegeben markiert.\n\n✅ Für eine Vermietung:\nTippen Sie auf 'Vermietung beenden'. Sie müssen dann:\n• Zahlungseingang bestätigen\n• Kaution handhaben (zurückgeben oder einbehalten)\n\n✅ Für eine Reparatur:\nTippen Sie auf 'Reparaturrückgabe bestätigen'. Geben Sie die endgültigen Kosten ein.\n\n💡 Tipp:\nRückgaben werden mit Zeitstempel versehen. Sie finden die vollständige Historie in jeder Karte.";

/* Anleitung - Vermietungen */
"guide_rentals_title" = "Ihre Geräte vermieten";
"guide_rentals_content" = "Vermietungen ermöglichen es Ihnen, Ihre Geräte gegen Bezahlung zu vermieten.\n\n➕ Vermietung erstellen:\n1. Wählen Sie das zu vermietende Gerät\n2. Wählen Sie den Mieter\n3. Legen Sie den Tariftyp fest:\n   • Tag (Preis × Anzahl Tage)\n   • Woche (Preis × Anzahl Wochen)\n   • Monat (Preis × Anzahl Monate)\n   • Festpreis\n4. Geben Sie den Kautionsbetrag ein\n5. Legen Sie die Daten fest\n\n📊 Dashboard:\n• Erhaltene Einnahmen (bestätigte Zahlungen)\n• Ausstehend (noch nicht bezahlt)\n\n✅ Vermietung beenden:\n1. Beenden Sie die Vermietung bei Rückgabe\n2. Bestätigen Sie den Zahlungseingang\n3. Handhaben Sie die Kaution (zurückgeben oder einbehalten)";

/* Anleitung - Kautionen */
"guide_caution_title" = "Kautionen verwalten";
"guide_caution_content" = "Die Kaution ist eine Garantie, die am Ende der Vermietung eingezogen wird.\n\n💵 Arten von Aktionen:\n\n🔙 Kaution zurückgeben:\nWenn alles OK ist, geben Sie die Kaution an den Mieter zurück. Sie zählt nicht als Einnahme.\n\n⚠️ Kaution einbehalten:\nBei Schäden oder Streitigkeiten behalten Sie ganz oder teilweise. Der einbehaltene Betrag wird zu Ihren Einnahmen hinzugefügt.\n\n📋 Verfolgung unter 'Weitere':\nDer Abschnitt 'Zurückzugebende Kautionen' listet alle abgeschlossenen Vermietungen mit ausstehender Kautionshandhabung auf.\n\n💰 Buchhaltung:\nNur einbehaltene Kautionen erscheinen in der Buchhaltung als außerordentliche Einnahmen.";

/* Anleitung - Untervermietung */
"guide_sublet_title" = "Geräte untervermieten";
"guide_sublet_content" = "Sie können Geräte untervermieten, die Sie selbst mieten.\n\n📤 Vorgehensweise:\n1. Gehen Sie zu Ihrer aktiven Vermietungskarte\n2. Tippen Sie auf 'Untervermieten'\n3. Wählen Sie den Untermieter\n4. Legen Sie Ihre eigenen Tarife und Bedingungen fest\n\n⚠️ Regeln:\n• Die Hauptvermietung kann nicht beendet werden, solange die Untervermietung aktiv ist\n• Holen Sie zuerst das Gerät von der Untervermietung zurück\n• Dann beenden Sie die Hauptvermietung\n\n💰 Einnahmen:\nUntervermietungseinnahmen werden zu Ihrer normalen Buchhaltung hinzugefügt.";

/* Anleitung - Ich miete */
"guide_myrentals_title" = "Ich miete - Geräte die ich miete";
"guide_myrentals_content" = "Der Bereich 'Ich miete' ermöglicht die Verwaltung von Geräten, die SIE von jemand anderem mieten (externe Gerätemiete).\n\n📤 Miete erstellen:\n1. Tippen Sie auf 'Miete hinzufügen'\n2. Benennen Sie das gemietete Gerät\n3. Wählen Sie den Vermieter (von wem Sie mieten)\n4. Legen Sie den Tariftyp fest (Tag/Woche/Monat/Pauschale)\n5. Geben Sie Preis und gezahlte Kaution ein\n6. Legen Sie Start- und Enddatum fest\n\n📊 Verfolgung:\n• Gesamtmietbetrag\n• Gezahlte und zurückerhaltene Kaution\n• Status: In Bearbeitung, Verspätet, Abgeschlossen\n• Zahlung erfolgt oder ausstehend\n\n✅ Miete beenden:\n1. Markieren Sie die Miete als abgeschlossen\n2. Geben Sie den zurückerhaltenen Kautionsbetrag ein\n3. Bestätigen Sie die erfolgte Zahlung\n\n⚠️ Erinnerungen:\nMieten mit nicht zurückerhaltener Kaution erscheinen als Warnungen.";

/* Anleitung - Meine Kautionen */
"guide_myrentals_caution_title" = "Meine gezahlten Kautionen verwalten";
"guide_myrentals_caution_content" = "Wenn Sie Geräte mieten, zahlen Sie oft eine Kaution.\n\n💵 Kautionsverfolgung:\n• Gezahlter Kautionsbetrag bei Vertragsabschluss\n• Zurückerhaltener Betrag am Ende der Miete\n• Differenz bei Einbehaltung\n\n🔄 Arbeitsablauf:\n1. Bei der Erstellung die gezahlte Kaution eingeben\n2. Am Ende der Miete den zurückerhaltenen Betrag eingeben\n3. Die Differenz wird automatisch berechnet\n\n📋 Warnungen:\nUnter 'Weitere > Ich miete' warnt Sie eine Meldung, wenn abgeschlossene Mieten nicht zurückerhaltene Kautionen haben.\n\n💰 Buchhaltung:\n• Gezahlte Kaution = vorübergehende Ausgabe\n• Zurückerhaltene Kaution = Erstattung\n• Nicht zurückerhaltene Kaution = Verlust (dauerhafte Ausgabe)";

/* Anleitung - Handel */
"guide_commerce_title" = "Kauf/Verkauf-Modul";
"guide_commerce_content" = "Das Handelsmodul ist ideal für Märkte, Geschäfte und Kleinunternehmen.\n\n📦 Funktionen:\n• Produktkatalog mit Einkaufs- und Verkaufspreisen\n• Automatische Lagerverwaltung\n• MwSt-Berechnung (erhoben, abzugsfähig, abzuführen)\n• Prozentuale oder feste Rabatte\n• Zahlungsarten (Bar, Karte, Scheck, Überweisung)\n• Aufgeschobene Zahlungen mit Erinnerungen\n\n📊 Handelsbuchhaltung:\n• Gesamtverkäufe / Einkäufe / Gewinne\n• MwSt-Detail nach Satz\n• Durchschnittlicher Warenkorb\n• Aufschlüsselung nach Zahlungsart\n• Niedrigbestandsalarme\n\n🔄 JSON-Export/Import zur Datensicherung.";

/* Anleitung - Artikel */
"guide_articles_title" = "Ihre Produkte verwalten";
"guide_articles_content" = "Produkte sind Artikel in Ihrem Handelskatalog.\n\n➕ Produkt erstellen:\n• Name und Beschreibung\n• Kategorie (eigene erstellen)\n• Referenz / SKU\n• Einkaufspreis netto und Einkaufs-MwSt-Satz\n• Verkaufspreis brutto und Verkaufs-MwSt-Satz\n• Aktueller Bestand und Alarmschwelle\n• Lieferant (optional)\n• Foto (optional)\n\n📊 Automatische Marge:\nDie App berechnet automatisch Ihre Marge und Prozentsatz.\n\n🔔 Bestandsalarme:\nWenn der Bestand unter die Schwelle fällt, erscheint der Artikel in den Alarmen.\n\n⚡ Schnellverkauf:\nLangen Druck auf ein Produkt für Schnellverkauf ohne komplexe Eingabe.";

/* Anleitung - Transaktionen */
"guide_transactions_title" = "Transaktionen erfassen";
"guide_transactions_content" = "Transaktionen sind Ihre Verkäufe und Einkäufe.\n\n🛒 Transaktion erstellen:\n1. Wählen Sie Typ: Verkauf oder Einkauf\n2. Wählen Sie einen Katalogartikel ODER geben Sie frei ein\n3. Geben Sie Menge ein\n4. Wenden Sie Rabatt an (optional): % oder Festbetrag\n5. Wählen Sie Zahlungsart: Bar, Karte, Scheck, Überweisung\n6. Geben Sie an, ob bezahlt oder ausstehend\n7. Wenn ausstehend, legen Sie Zahlungsdatum fest\n\n📊 Automatische Zusammenfassung:\n• Bruttobetrag netto\n• Angewandter Rabatt\n• Nettobetrag netto\n• Berechnete MwSt\n• Gesamtbetrag brutto\n\n🔔 Erinnerungen:\nAktivieren Sie Benachrichtigungen für bevorstehende Zahlungen (3 Tage vorher).";

/* Anleitung - Buchhaltung */
"guide_accounting_title" = "Vermietungsbuchhaltung";
"guide_accounting_content" = "Die Buchhaltung gruppiert automatisch Ihre Finanzoperationen.\n\n📊 Inhalt:\n• Einnahmen: Bezahlte Vermietungen\n• Einnahmen: Einbehaltene Kautionen\n• Ausgaben: Bezahlte Reparaturen\n\n📅 Zeiträume:\n• Ansicht nach Monat\n• Ansicht nach Jahr\n• Gesamtansicht\n\n💰 Kennzahlen:\n• Gesamteinnahmen (grün)\n• Gesamtausgaben (rot)\n• Nettogewinn\n\n📤 Export:\n• Formatiertes PDF für die Buchhaltung\n• JSON für Backup/Import\n\nOperationen werden automatisch hinzugefügt, wenn Sie eine Zahlung als erhalten markieren.";

/* Anleitung - Handelsbuchhaltung */
"guide_commerce_accounting_title" = "Handelsbuchhaltung";
"guide_commerce_accounting_content" = "Vollständige Ansicht Ihrer Verkaufsaktivität.\n\n📊 Dashboard:\n• Gesamtverkäufe brutto\n• Gesamteinkäufe brutto\n• Nettogewinn\n• Durchschnittlicher Warenkorb (Verkäufe und Einkäufe)\n\n💹 Detaillierte MwSt:\n• Erhobene MwSt (auf Verkäufe)\n• Abzugsfähige MwSt (auf Einkäufe)\n• Abzuführende MwSt (Differenz)\n• Detail nach Satz (5,5%, 10%, 20%...)\n\n💳 Zahlungsaufschlüsselung:\n• Bar / Karte / Scheck / Überweisung\n• Prozentuale Visualisierung\n\n📦 Lager:\n• Anzahl Artikel auf Lager\n• Artikel in Alarm (niedriger Bestand)\n\n💸 Gewährte Rabatte:\n• Gesamtverkaufsrabatte\n• Gesamteinkaufsrabatte";

/* Anleitung - Personen */
"guide_people_title" = "Kontaktliste";
"guide_people_content" = "Verwalten Sie Personen, mit denen Sie interagieren.\n\n➕ Person hinzufügen:\n• Vor- und Nachname\n• E-Mail (ermöglicht E-Mail-Versand)\n• Telefon (ermöglicht direkte Anrufe)\n• Organisation (Firma, Verein...)\n• Typ: Person, Reparateur oder Mitarbeiter\n• Foto (optional)\n\n📧 Erinnerungs-E-Mail:\nVon der Personenkarte aus eine E-Mail senden, die automatisch auflistet:\n• Aktuell verliehene Geräte\n• Erwartete Rückgabedaten\n• Verspätungsanzeigen\n\n📞 Direktanruf:\nTippen Sie auf die Telefonnummer, um direkt anzurufen.\n\n📇 Kontakte importieren:\nAutomatisch aus Ihren iPhone-Kontakten importieren.";

/* Anleitung - Personentypen */
"guide_people_types_title" = "Personentypen";
"guide_people_types_content" = "Drei Typen zur Organisation Ihrer Kontakte:\n\n👤 Person (Standard):\nKunden, Freunde, Familie... Jeder, dem Sie Geräte verleihen oder vermieten.\n\n🔧 Reparateur:\nHandwerker und Reparaturwerkstätten. Nur Reparateure können beim Senden zur Reparatur ausgewählt werden.\n\n👷 Mitarbeiter:\nTeammitglieder. Können Baustellen zugewiesen werden. Ideal für Unternehmen mit mehreren Standorten.\n\n💡 Tipp:\nEine Person kann nur einen Typ haben. Ändern Sie ihn jederzeit von ihrer Karte.";

/* Anleitung - Duplikate */
"guide_duplicates_title" = "Duplikate zusammenführen";
"guide_duplicates_content" = "Die App erkennt automatisch doppelte Personen.\n\n🔍 Funktionsweise:\n• Erkennung nach identischem Vor- + Nachnamen\n• Ignoriert Groß-/Kleinschreibung und Leerzeichen\n\n🔄 Zusammenführen:\n1. Gehen Sie zu Weitere > Personen\n2. Tippen Sie auf die Schaltfläche 'Duplikate' in der Symbolleiste\n3. Wählen Sie die Duplikatgruppe\n4. Wählen Sie die zu behaltende Person\n5. Bestätigen Sie die Zusammenführung\n\n✅ Ergebnis:\n• Alle Ausleihen werden neu zugewiesen\n• Alle Leihen werden neu zugewiesen\n• Alle Vermietungen werden neu zugewiesen\n• Duplikate werden gelöscht\n\n💡 Überprüfen Sie die Kontaktdaten der behaltenen Person.";

/* Anleitung - Baustellen */
"guide_worksites_title" = "Baustellenverwaltung";
"guide_worksites_content" = "Organisieren Sie Ihr Team über mehrere Arbeitsorte.\n\n🏗️ Baustelle erstellen:\n• Baustellenname\n• Vollständige Adresse\n• Beschreibung und Notizen\n• Start- und Enddaten\n• Hauptkontakt vor Ort\n• Status: Aktiv oder Abgeschlossen\n\n👷 Mitarbeiter zuweisen:\n1. Erstellen Sie Personen vom Typ 'Mitarbeiter'\n2. Öffnen Sie die Baustellenkarte\n3. Fügen Sie die relevanten Mitarbeiter hinzu\n\n🗺️ Navigation:\nTippen Sie auf die Adresse, um sie in Karten zu öffnen.\n\n📊 Automatische Status:\n• In Vorbereitung: Startdatum nicht erreicht\n• Aktiv: Laufend\n• Abgeschlossen: Als fertig markiert\n\n📤 Export als PDF oder JSON.";

/* Anleitung - Orte */
"guide_locations_title" = "Lagerorte";
"guide_locations_content" = "Organisieren Sie, wo Ihre Geräte gelagert werden.\n\n📍 Ort erstellen:\n• Name (z.B. Garage, Nordlager...)\n• Vollständige Adresse\n• Gebäude\n• Etage\n• Raum\n• Notizen\n\n📦 Verwendung:\n• Verknüpfen Sie jedes Gerät mit einem Ort\n• Fügen Sie präzise Platzierung hinzu (z.B. Regal B, Schublade 3)\n• Filtern Sie Ihr Inventar nach Ort\n\n🔍 Artikel finden:\n1. Suchen Sie ihn in Material\n2. Die Karte zeigt Ort und genaue Platzierung\n\n📊 Übersicht:\nEine Ortskarte zeigt alle dort gelagerten Geräte.";

/* Anleitung - Kategorien */
"guide_categories_title" = "Kategorien verwalten";
"guide_categories_content" = "Kategorien organisieren Ihr Inventar.\n\n➕ Kategorie erstellen:\nBeim Hinzufügen von Geräten einen neuen Kategorienamen eingeben.\n\n🗂️ Vorgeschlagene Kategorien:\n• Werkzeuge\n• Elektronik\n• Sport\n• Küche\n• Garten\n• Heimwerken\n• Musik\n• Foto/Video\n\n📝 Kategorien verwalten:\n1. In der Materialliste\n2. Tippen Sie auf das Ordnersymbol neben dem Kategoriefilter\n3. Umbenennen oder löschen\n\n⚠️ Kategorie löschen:\nGeräte werden nicht gelöscht, sie verlieren nur ihre Kategorie.";

/* Anleitung - Suche */
"guide_search_title" = "Suche und Filter";
"guide_search_content" = "Finden Sie schnell jeden Artikel.\n\n🔍 Suchleiste:\n• Auf jeder Liste verfügbar\n• Durchsucht Name und Beschreibung\n• Echtzeit-Ergebnisse\n\n🎯 Kombinierbare Filter:\n\n📦 Material:\n• Nach Kategorie\n• Nach Lagerort\n• Nach Status (Verfügbar, Verliehen, Vermietet)\n\n↗️ Ausleihen / ↙️ Leihen:\n• Alle / Laufend / Verspätet / Zurückgegeben / Bald\n\n🏷️ Vermietungen:\n• Nach Status\n• Nach Zahlungsstatus\n• Nach Kautionsstatus\n\n🔧 Reparaturen:\n• In Bearbeitung / Abgeschlossen\n• Bezahlt / Unbezahlt\n\n💡 Zurücksetzen-Button:\nAlle Filter mit einem Tippen zurücksetzen.";

/* Anleitung - Status */
"guide_status_title" = "Status verstehen";
"guide_status_content" = "Farbcodes in der gesamten App:\n\n🟢 Grün:\n• Verfügbar\n• Zurückgegeben\n• Bezahlt\n• Abgeschlossen\n\n🟡 Orange:\n• Laufend\n• Bald (< 3 Tage)\n• Wartet auf Zahlung\n\n🔴 Rot:\n• Verspätet\n• Unbezahlt (Datum überschritten)\n• Problem erkannt\n\n🔵 Blau:\n• Information\n• Klickbarer Link\n• Verfügbare Aktion\n\n📊 Visuelle Indikatoren:\n• Uhr-Symbol: Laufend\n• Dreieck-Symbol: Verspätet\n• Häkchen-Symbol: Abgeschlossen/Zurückgegeben\n• Zahlen-Badge: Anzahl";

/* Anleitung - Tresor */
"guide_safe_title" = "Sicherer Tresor";
"guide_safe_content" = "Schützen Sie Ihre wichtigen Dokumente mit sicherem Zugang.\n\n🔐 Einrichtung:\n1. Erstellen Sie ein Passwort (min. 4 Zeichen)\n2. Wählen Sie eine Wiederherstellungsfrage\n3. Beantworten Sie die geheime Frage\n\n📦 Empfohlener Inhalt:\n• Wertvoller Schmuck und Uhren\n• Teure Elektronik\n• Kunstwerke\n• Wichtige Dokumente\n• Belege größerer Anschaffungen\n\n🏷️ Für jeden Artikel:\n• Foto des Artikels\n• Name und Beschreibung\n• Geschätzter Wert\n• Marke, Modell, Seriennummer\n• Beleg/Kaufnachweis-Foto\n\n📄 Versicherungsinventar:\nExportieren Sie ein vollständiges PDF für Ihren Versicherer.";

/* Anleitung - Biometrie */
"guide_biometric_title" = "Face ID / Touch ID";
"guide_biometric_content" = "Zugriff auf den Tresor mit Biometrie.\n\n✅ Vorteile:\n• Schneller Zugang ohne Passworteingabe\n• Erhöhte Sicherheit\n• Gleiches Schutzniveau wie Ihr iPhone\n\n🔧 Aktivierung:\nBiometrische Authentifizierung ist automatisch, wenn Ihr Gerät sie unterstützt.\n\n📱 Kompatibilität:\n• Face ID (iPhone X und neuer)\n• Touch ID (iPhone mit Sensor)\n\n🔑 Fallback:\nWenn Biometrie fehlschlägt, geben Sie Ihr Passwort ein.\n\n⚠️ Passwort vergessen:\n1. Nutzen Sie die Wiederherstellungsfrage\n2. Letzter Ausweg: Vollständiger Reset (Datenverlust)";

/* Anleitung - Passwort */
"guide_password_title" = "Passwortverwaltung";
"guide_password_content" = "Sichern Sie Ihren Tresor mit einem starken Passwort.\n\n🔑 Regeln:\n• Mindestens 4 Zeichen\n• Bestätigung erforderlich\n• Wiederherstellungsfrage empfohlen\n\n🔄 Passwort ändern:\n1. Öffnen Sie den Tresor\n2. Menü > Passwort ändern\n3. Geben Sie altes Passwort ein\n4. Geben Sie neues ein und bestätigen Sie\n\n❓ Passwort vergessen:\n1. Tippen Sie auf 'Passwort vergessen?'\n2. Beantworten Sie die geheime Frage\n3. Erstellen Sie ein neues Passwort\n\n⚠️ Alles vergessen:\nWenn Sie Passwort UND Antwort vergessen haben, ist die einzige Option ein vollständiger Reset. Alle Daten gehen verloren.";

/* Anleitung - Rechnungen */
"guide_invoices_title" = "Belegverwaltung";
"guide_invoices_content" = "Bewahren Sie Ihre Kaufbelege digital auf.\n\n🧾 Für jedes Gerät:\n• Belegfoto (JPG oder PDF)\n• Belegnummer\n• Verkäufer-/Geschäftsname\n• Anschaffungsdatum (automatisch oder manuell)\n\n🏠 Für den Tresor:\n• Beleg-/Kaufnachweis-Foto\n• Gleiche Informationen\n\n💡 Verwendung:\n• Eigentumsnachweis für Versicherung\n• Garantieverfolgung\n• Beweise bei Streitigkeiten\n• Export in PDF-Karten\n\n📤 Export:\nBelege sind enthalten in:\n• Geräte-PDF-Karten\n• Versicherungsinventar-PDF\n• JSON-Backup";

/* Anleitung - Backup */
"guide_backup_title" = "Backup und Wiederherstellung";
"guide_backup_content" = "Schützen Sie Ihre Daten mit regelmäßigen Backups.\n\n💾 Lokales Backup:\nTippen Sie in den Einstellungen auf 'Jetzt sichern'. Erstellt einen lokalen Wiederherstellungspunkt.\n\n📤 JSON-Export:\nExportieren Sie alle Ihre Daten (oder Auswahl) im JSON-Format:\n• Per E-Mail senden\n• In Dateien speichern\n• Per AirDrop teilen\n\n📥 JSON-Import:\nStellen Sie Ihre Daten aus einer zuvor exportierten JSON-Datei wieder her.\n\n✅ Exportierte Daten:\n• Geräte + Fotos\n• Ausleihen und Leihen\n• Vermietungen und Reparaturen\n• Personen\n• Orte und Baustellen\n• Handel (Produkte + Transaktionen)\n• Tresor";

/* Anleitung - PDF */
"guide_pdf_title" = "PDF-Export";
"guide_pdf_content" = "Erstellen Sie professionelle PDF-Dokumente.\n\n📄 Exporttypen:\n\n📦 Gerätekatalog:\n• Detaillierte Karte pro Artikel\n• Foto + Beschreibung\n• Wert und Lagerort\n• Belegfoto\n\n🔐 Versicherungsinventar:\n• Vollständige Tresorliste\n• Fotos und Kaufnachweise\n• Geschätzter Gesamtwert\n• Zum Senden an Ihren Versicherer\n\n📊 Buchhaltung:\n• Operationsübersicht\n• Einnahmen und Ausgaben\n• Nach Zeitraum (Monat/Jahr)\n\n💡 Optionen:\n• Zurückgegebene Artikel ausschließen\n• Bildqualität wählen\n• Datentypen auswählen";

/* Anleitung - JSON */
"guide_json_title" = "JSON-Export/Import";
"guide_json_content" = "Das JSON-Format ist ideal für vollständige Backups.\n\n✅ Vorteile:\n• Strukturierte Daten\n• Enthält alle Fotos\n• Vollständige Wiederherstellung möglich\n• Übertragung zwischen Geräten\n\n📤 Export:\n1. Einstellungen > Exportieren\n2. Daten auswählen\n3. .json-Datei teilen\n\n📥 Import:\n1. Einstellungen > JSON importieren\n2. Datei auswählen\n3. Daten werden zusammengeführt (keine Duplikate)\n\n💡 Tipp:\nMachen Sie monatlich einen JSON-Export und speichern Sie ihn auf iCloud, Google Drive oder per E-Mail.\n\n⚠️ Import:\nVorhandene Elemente (gleiche ID) werden nicht dupliziert.";

/* Anleitung - Bildqualität */
"guide_image_quality_title" = "Bildqualität";
"guide_image_quality_content" = "Optimieren Sie Ihre Exportgröße.\n\n📷 Verfügbare Optionen:\n\n🟣 Original (iPhone):\n• Maximale Qualität\n• Sehr große Dateien (~5 MB)\n• Für hochwertige Archivierung\n\n🔵 Hoch (2000px):\n• Ausgezeichnete Qualität\n• Reduzierte Größe (~2 MB)\n• Guter Kompromiss\n\n🟢 Mittel (1200px):\n• Gute Qualität\n• Leichte Dateien (~800 KB)\n• Empfohlen ✅\n\n🟠 Niedrig (800px):\n• Akzeptable Qualität\n• Sehr leicht (~300 KB)\n• Für zahlreiche Exporte\n\n⚙️ Ändern:\nEinstellungen > Bildqualität";

/* Anleitung - Tipps */
"guide_tips_title" = "Praktische Tipps";
"guide_tips_content" = "Holen Sie das Beste aus der App:\n\n📸 Fotos:\n• Fotografieren Sie jeden wertvollen Artikel\n• Erfassen Sie Seriennummern\n• Bewahren Sie Belegfotos auf\n\n👥 Kontakte:\n• Erstellen Sie Personen vor Ausleihen\n• Geben Sie E-Mails und Telefone ein\n• Nutzen Sie Kontakt-Import\n\n📅 Daten:\n• Seien Sie realistisch bei Rückgabedaten\n• Überprüfen Sie regelmäßig Verspätungen\n• Senden Sie E-Mail-Erinnerungen\n\n💾 Backups:\n• Exportieren Sie monatlich JSON\n• Speichern Sie in der Cloud\n• Testen Sie eine Wiederherstellung\n\n🔐 Tresor:\n• Inventarisieren Sie Ihre Wertsachen\n• Bewahren Sie Kaufbelege auf\n• Exportieren Sie für die Versicherung";

/* Anleitung - Best Practices */
"guide_best_practices_title" = "Best Practices";
"guide_best_practices_content" = "Optimieren Sie Ihre tägliche Nutzung:\n\n✅ Tun Sie:\n• Machen Sie ein Foto VOR dem Verleihen\n• Notieren Sie Zustand in Notizen\n• Bestätigen Sie Rückgaben schnell\n• Halten Sie Kategorien konsistent\n• Machen Sie regelmäßige Backups\n\n❌ Vermeiden Sie:\n• Vergessen, Rückgaben zu bestätigen\n• Ignorieren verspäteter Ausleihen\n• Personen und Reparateure mischen\n• Belegfotos vernachlässigen\n\n💡 Idealer Workflow:\n1. Erstellen Sie Ihre Lagerorte\n2. Fügen Sie wichtige Kontakte hinzu\n3. Inventarisieren Sie Ihre Geräte\n4. Fotografieren Sie Belege\n5. Nutzen Sie täglich die Schnellerstellung";

/* Anleitung - E-Mail */
"guide_email_title" = "E-Mails senden";
"guide_email_content" = "Kommunizieren Sie einfach mit Ihren Kontakten.\n\n📧 Erinnerungs-E-Mail:\n1. Öffnen Sie die Personenkarte\n2. Tippen Sie auf das E-Mail-Symbol\n3. Eine vorausgefüllte Nachricht öffnet sich mit:\n   • Liste verliehener Geräte\n   • Erwartete Rückgabedaten\n   • Verspätungsanzeigen\n\n📧 Zahlungserinnerung:\nFür unbezahlte Vermietungen eine Erinnerung mit fälligen Beträgen senden.\n\n✅ Voraussetzungen:\n• E-Mail muss in der Karte eingetragen sein\n• Mail-App muss konfiguriert sein\n\n💡 Anpassen:\nDie Nachricht öffnet sich in Mail, Sie können sie vor dem Senden bearbeiten.";

/* Anleitung - Alarme */
"guide_alerts_title" = "Alarme und Benachrichtigungen";
"guide_alerts_content" = "Die App warnt Sie visuell:\n\n🔴 Verspätungsanzeigen:\n• Rotes Badge bei verspäteten Ausleihen\n• Warndreieck bei Leihen\n• Rote Farbe in Listen\n\n🟡 Bevorstehende Fristen:\n• 'Bald'-Filter (< 3 Tage)\n• Orange Farbe\n\n💰 Zahlungen:\n• Abschnitt 'Bevorstehende Zahlungen'\n• Abschnitt 'Verspätete Zahlungen'\n• Handelsalarme für Fristen\n\n📦 Niedriger Bestand:\n• Badge bei Artikeln im Alarm\n• Sichtbar im Handel\n\n💡 Tipp:\nÜberprüfen Sie regelmäßig 'Verspätet'- und 'Bald'-Filter zur Vorausplanung.";

/* Anleitung - Kapazität */
"guide_capacity_title" = "Kapazität und Grenzen";
"guide_capacity_content" = "Kostenlose Version vs Premium:\n\n🆓 Kostenlose Version:\n• 10 Geräte\n• 5 aktive Ausleihen\n• 5 aktive Leihen\n• 5 Vermietungen\n• 5 Reparaturen\n• 10 Personen\n• 3 Orte\n• 5 Tresor-Objekte\n\n👑 Premium-Version:\n• Alles UNBEGRENZT!\n• Einmalzahlung, lebenslanger Zugang\n• Unterstützen Sie die Entwicklung\n\n💾 Speicher:\n• Lokale Daten auf Ihrem iPhone\n• Keine technische Grenze\n• Fotos nehmen mehr Platz ein\n\n💡 Tipp:\nMachen Sie regelmäßige Backups, besonders bei vielen Daten.";

/* Anleitung - Premium */
"guide_premium_title" = "Premium werden";
"guide_premium_content" = "Schalten Sie das volle Potenzial der App frei.\n\n👑 Premium-Vorteile:\n• Unbegrenzte Geräte\n• Unbegrenzte Ausleihen\n• Unbegrenzte Leihen\n• Unbegrenzte Vermietungen\n• Unbegrenzte Reparaturen\n• Unbegrenzte Personen\n• Unbegrenzte Orte\n• Unbegrenzter Tresor\n\n💳 Zahlung:\n• Einmalzahlung\n• Lebenslanger Zugang\n• Kein Abo\n\n🔄 Wiederherstellen:\nBei Gerätewechsel:\n1. Gehen Sie zu Premium\n2. Tippen Sie auf 'Käufe wiederherstellen'\n3. Ihre Käufe werden wiederhergestellt\n\n❤️ Unterstützung:\nIhr Kauf hilft, die App zu verbessern!";

/* Anleitung - FAQ */
"guide_faq_title" = "Häufig gestellte Fragen";
"guide_faq_content" = "❓ Sind meine Daten sicher?\nJa, alles wird lokal auf Ihrem iPhone gespeichert. Der Tresor ist passwortgeschützt.\n\n❓ Kann ich die App auf iPad/Mac nutzen?\nJa, die App ist universell und funktioniert auf iPhone, iPad und Mac (Apple Silicon).\n\n❓ Wie übertrage ich meine Daten?\nExportieren Sie als JSON, dann importieren Sie auf dem neuen Gerät.\n\n❓ Funktioniert die App offline?\nJa, alle Funktionen sind ohne Internet verfügbar.\n\n❓ Wie kontaktiere ich den Support?\nSenden Sie eine E-Mail von der App Store-Seite oder aus den Einstellungen.\n\n❓ Sind Updates kostenlos?\nJa, alle Updates sind inbegriffen.";

